<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>

<AnchorPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Genex.Controllers.Tutorial.TutorialController"
            prefHeight="720.0" prefWidth="1280.0"
            styleClass="main-container"
            stylesheets="@Tutorial.css">

    <VBox spacing="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <!-- Top Navigation Bar -->
        <HBox alignment="CENTER" prefHeight="80.0" styleClass="top-nav">
            <padding>
                <Insets left="40" right="40"/>
            </padding>

            <!-- Left: Logo -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <HBox styleClass="logo-box" alignment="CENTER">
                    <Label text="GG" styleClass="logo-icon"/>
                </HBox>
                <VBox alignment="CENTER_LEFT">
                    <Label text="GENEX COACH" styleClass="nav-brand"/>
                    <Label text="COMMAND CENTER" styleClass="nav-subtitle"/>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Center: Links -->
            <HBox alignment="CENTER" spacing="40">
                <Button text="TUTORIALS" styleClass="nav-link, active-link"/>
                <Button text="QUIZZES" onAction="#goToQuizzes" styleClass="nav-link"/>
                <Button text="PLAYERS" styleClass="nav-link"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Right: Profile -->
            <HBox alignment="CENTER_RIGHT" spacing="15">
                <VBox alignment="CENTER_RIGHT">
                    <Label text="Coach Marcus" styleClass="profile-name"/>
                    <Label text="Head of Strategy" styleClass="profile-role"/>
                </VBox>
                <StackPane styleClass="avatar-container">
                    <Region prefWidth="40" prefHeight="40" styleClass="avatar-circle"/>
                </StackPane>
            </HBox>
        </HBox>

        <VBox spacing="30.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="40" right="60" bottom="40" left="60"/>
            </padding>

            <!-- Header Section -->
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="▶" styleClass="campaign-icon"/>
                        <Label text="CAMPAIGN TRAINING" styleClass="subtitle-label"/>
                    </HBox>
                    <Label text="COACH HUB" styleClass="title-label"/>
                    <Label text="Create and manage strategic tutorials for your roster. Shape the meta and lead your team to victory." styleClass="header-desc"/>
                </VBox>
                <Button fx:id="addTutorialBtn" text="+ NEW TUTORIAL" styleClass="primary-button" onAction="#handleAddTutorial"/>
            </HBox>

            <!-- Search Bar -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <HBox alignment="CENTER_LEFT" styleClass="search-container" HBox.hgrow="ALWAYS">
                    <Label text="🔍" styleClass="search-icon"/>
                    <TextField fx:id="searchField" promptText="Search training modules..." HBox.hgrow="ALWAYS" styleClass="search-input"/>
                </HBox>
                <Button text="▥ FILTERS" styleClass="filter-button"/>
            </HBox>

            <!-- Scrollable content Area -->
            <ScrollPane fitToWidth="true" styleClass="custom-scroll" VBox.vgrow="ALWAYS">
                <FlowPane fx:id="tutorialContainer" hgap="30" vgap="40" prefWrapLength="1000">
                    <!-- Cards injected by controller -->
                </FlowPane>
            </ScrollPane>
        </VBox>
    </VBox>
</AnchorPane>
