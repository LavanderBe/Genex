<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStackPane" styleClass="main-content" stylesheets="@TeamHub.css, @PlayerTeams.css"
           xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Genex.Controllers.Team.TeamHubController">

    <VBox fx:id="contentArea" spacing="20">
        <padding>
            <Insets bottom="25" left="25" right="25" top="25" />
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label styleClass="page-title" text="Équipes" />
            <Button fx:id="btnBackFromRanking" onAction="#backToTeamList"
                    visible="false" managed="false"
                    styleClass="player-view-btn" text="RETOUR" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnAddTeam" onAction="#openAddTeamDrawer"
                    styleClass="player-add-session-btn" text="＋  AJOUTER" />
            <Button fx:id="btnRanking" onAction="#openRankingView"
                    styleClass="player-view-btn" text="RANKING" />
            <TextField fx:id="searchField" prefWidth="250"
                       promptText="Rechercher une équipe..." styleClass="search-field" />
        </HBox>

        <!-- Teams Grid -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: transparent;"
                    styleClass="scroll-pane" vbarPolicy="ALWAYS"
                    VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="teamCardsContainer" hgap="20"
                          prefWrapLength="1200" styleClass="cards-container" vgap="20" />
            </content>
        </ScrollPane>
    </VBox>

</StackPane>
