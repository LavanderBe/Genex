<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStackPane" styleClass="main-content" stylesheets="@TeamHub.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Genex.Controllers.Team.TeamHubController">

    <VBox fx:id="contentArea" spacing="20" stylesheets="@TeamHub.css">
        <padding>
            <Insets bottom="25" left="25" right="25" top="25" />
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label style="-fx-font-size: 24; -fx-text-fill: white; -fx-font-weight: bold;" styleClass="page-title" text="Equipes" />
            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="btnAddTeam" onAction="#openAddTeamModal" styleClass="action-blue-button" stylesheets="@TeamHub.css" text="+ Nouvelle Équipe" />

            <TextField fx:id="searchField" prefWidth="250" promptText="Rechercher une équipe..." styleClass="search-field" />
            <Button fx:id="btnSearch" styleClass="icon-btn" text="🔍" />
        </HBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;" styleClass="scroll-pane" vbarPolicy="ALWAYS" VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="teamCardsContainer" hgap="20" prefWrapLength="1000" styleClass="cards-container" vgap="20">

                </FlowPane>
            </content>
        </ScrollPane>
    </VBox>

</StackPane>
