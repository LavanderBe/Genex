<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStackPane" styleClass="main-content" stylesheets="@TeamHub.css"
           xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Genex.Controllers.Team.TeamHubController">

    <HBox spacing="0" VBox.vgrow="ALWAYS">

        <!-- ══ LEFT: Teams list ══════════════════════════════════════ -->
        <VBox fx:id="contentArea" spacing="20" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="25" left="25" right="25" top="25" />
            </padding>

            <!-- Header row -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label styleClass="page-title" text="Equipes" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnAddTeam" onAction="#toggleFormPanel"
                        styleClass="action-blue-button" text="＋  AJOUTER" />
                <TextField fx:id="searchField" prefWidth="220"
                           promptText="🔍  Rechercher une équipe..."
                           styleClass="search-field" />
            </HBox>

            <!-- Cards -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                        style="-fx-background-color: transparent;"
                        styleClass="scroll-pane" vbarPolicy="ALWAYS"
                        VBox.vgrow="ALWAYS">
                <content>
                    <FlowPane fx:id="teamCardsContainer" hgap="20"
                              prefWrapLength="900" styleClass="cards-container" vgap="20" />
                </content>
            </ScrollPane>
        </VBox>

        <!-- ══ RIGHT: Inline form card (Finance style) ═══════════════ -->
        <VBox fx:id="formPanel" styleClass="form-card" spacing="14"
              prefWidth="320" minWidth="300" managed="false" visible="false">
            <padding>
                <Insets bottom="28" left="24" right="24" top="28" />
            </padding>

            <!-- Form title + close -->
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="formPanelTitle" styleClass="form-title" text="Nouvelle équipe" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#toggleFormPanel" styleClass="btn-close" text="✕" />
            </HBox>

            <Separator styleClass="drawer-sep" />

            <!-- Nom -->
            <VBox spacing="6">
                <Label styleClass="field-label" text="NOM *" />
                <TextField fx:id="txtName" styleClass="input-field" promptText="Ex: Team Vitality" />
                <Label fx:id="errorName" managed="false" styleClass="err-label" visible="false" />
            </VBox>

            <!-- Jeu -->
            <VBox spacing="6">
                <Label styleClass="field-label" text="JEU *" />
                <ChoiceBox fx:id="choiceGame" maxWidth="Infinity" styleClass="input-field" />
                <Label fx:id="errorGameId" managed="false" styleClass="err-label" visible="false" />
            </VBox>

            <!-- Contact -->
            <VBox spacing="6">
                <Label styleClass="field-label" text="CONTACT *" />
                <TextField fx:id="txtContact" styleClass="input-field" promptText="contact@team.com" />
                <Label fx:id="errorContact" managed="false" styleClass="err-label" visible="false" />
            </VBox>

            <!-- Logo -->
            <VBox spacing="6">
                <Label styleClass="field-label" text="LOGO (PNG / JPEG)" />
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="txtLogoFileName" styleClass="input-field"
                               promptText="Choisir un fichier…"
                               editable="false" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnUploadLogo" onAction="#handleUploadLogo"
                            styleClass="btn-pick" text="📁" />
                </HBox>
            </VBox>

            <!-- Statut -->
            <VBox spacing="6">
                <Label styleClass="field-label" text="STATUT" />
                <ChoiceBox fx:id="choiceStatus" maxWidth="Infinity" styleClass="input-field" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Buttons -->
            <HBox spacing="10">
                <Button fx:id="btnSave" onAction="#saveTeam" styleClass="primary-btn"
                        text="ENREGISTRER" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="44" />
                <Button onAction="#cancelForm" styleClass="secondary-btn"
                        text="ANNULER" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="44" />
            </HBox>
        </VBox>

    </HBox>

</StackPane>
