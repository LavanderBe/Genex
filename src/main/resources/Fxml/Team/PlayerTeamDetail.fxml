<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background-color: #0d0d1a; -fx-background: #0d0d1a;"
            stylesheets="@PlayerTeams.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Genex.Controllers.Team.PlayerTeamDetailController">

    <content>
        <VBox fx:id="rootVBox" spacing="0"
              style="-fx-background-color: #0d0d1a;">

            <!-- ── Nav Bar ───────────────────────────────────────── -->
            <HBox fx:id="navBar" alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: #12122a; -fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0; -fx-padding: 12 20 12 20;">
                    <Label fx:id="teamNameLabel"
                           style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"
                           text="Team Name" />
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox spacing="8" alignment="CENTER">
                        <Button fx:id="btnMonEquipe" text="Mon Équipe"
                                styleClass="player-tab-btn-active"
                                onAction="#handleMonEquipe" />
                        <Button fx:id="btnAutresEquipes" text="Autres Équipes"
                                styleClass="player-tab-btn"
                                onAction="#handleAutresEquipes" />
                    </HBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnQuitTeam" text="Quitter l'équipe"
                            styleClass="player-quit-btn"
                            onAction="#handleQuitTeam"
                            visible="false" managed="false" />
                </HBox>

                <!-- ── Swappable area ────────────────────────────────── -->
                <StackPane fx:id="swapPane">

                <!-- MON ÉQUIPE content -->
                <VBox fx:id="mainContent" spacing="16">
                    <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>

                    <!-- 2-Column Split: Members | Info -->
                    <HBox fx:id="splitPanel" spacing="16">

                        <!-- LEFT: Members -->
                        <VBox fx:id="leftPanel" spacing="12" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #1a1a2e; -fx-border-color: rgba(139,13,13,0.4); -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 18;">

                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px; -fx-font-weight: bold;"
                                       text="MEMBRES" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="memberCountLabel" styleClass="player-member-count"
                                       text="0 / 5 membres" />
                            </HBox>

                            <VBox fx:id="membersContainer" spacing="8" />
                        </VBox>

                        <!-- RIGHT: Logo + Jersey + Info -->
                        <VBox fx:id="rightPanel" spacing="14" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #1a1a2e; -fx-border-color: rgba(139,13,13,0.4); -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 18;">

                            <!-- Top Row: Logo (Left) + Jersey (Right) -->
                            <HBox spacing="16" alignment="TOP_LEFT">
                                <!-- Logo (Smaller, Left Side) -->
                                <VBox spacing="6" alignment="TOP_CENTER" prefWidth="120">
                                    <Label style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 10px; -fx-font-weight: bold;" text="LOGO" />
                                    <StackPane alignment="CENTER" maxHeight="100" minHeight="100">
                                        <Circle fx:id="logoCircle" radius="44"
                                                style="-fx-fill: #0d0d1a; -fx-stroke: #8B0D0D; -fx-stroke-width: 2;" />
                                        <ImageView fx:id="teamLogo" fitWidth="76" fitHeight="76"
                                                   preserveRatio="true">
                                            <clip>
                                                <Circle radius="38" centerX="38" centerY="38" />
                                            </clip>
                                        </ImageView>
                                        <Text fx:id="teamIconFallback"
                                              style="-fx-fill: #8B0D0D; -fx-font-size: 28px;"
                                              text="▶" visible="false" />
                                    </StackPane>
                                </VBox>

                                <!-- Jersey (Larger, Right Side) -->
                                <VBox spacing="6" alignment="TOP_CENTER" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 10px; -fx-font-weight: bold;" text="MAILLOT" />
                                    <StackPane alignment="CENTER" prefHeight="180" maxHeight="180">
                                        <javafx.scene.shape.Rectangle width="160" height="180" 
                                                style="-fx-fill: #0d0d1a; -fx-stroke: #8B0D0D; -fx-stroke-width: 2; -fx-arc-width: 12; -fx-arc-height: 12;" />
                                        <ImageView fx:id="teamJersey" fitWidth="150" fitHeight="170"
                                                   preserveRatio="true">
                                            <clip>
                                                <javafx.scene.shape.Rectangle width="150" height="170" arcWidth="10" arcHeight="10" />
                                            </clip>
                                        </ImageView>
                                        <Text fx:id="jerseyIconFallback"
                                              style="-fx-fill: #8B0D0D; -fx-font-size: 48px;"
                                              text="👕" visible="false" />
                                    </StackPane>
                                </VBox>
                            </HBox>

                            <!-- Info rows -->
                            <VBox spacing="3">
                                <Label style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 10px; -fx-font-weight: bold;" text="JEU" />
                                <Label fx:id="infoGame" style="-fx-text-fill: white; -fx-font-size: 13px;" text="—" />
                            </VBox>
                            <VBox spacing="3">
                                <Label style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 10px; -fx-font-weight: bold;" text="CONTACT" />
                                <Label fx:id="infoContact" style="-fx-text-fill: white; -fx-font-size: 13px;" text="—" />
                            </VBox>
                            <VBox spacing="3">
                                <Label style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 10px; -fx-font-weight: bold;" text="STATUT" />
                                <Label fx:id="infoStatus" style="-fx-text-fill: white; -fx-font-size: 13px;" text="—" />
                            </VBox>
                            <VBox spacing="3">
                                <Label style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 10px; -fx-font-weight: bold;" text="FONDÉE LE" />
                                <Label fx:id="infoDate" style="-fx-text-fill: white; -fx-font-size: 13px;" text="—" />
                            </VBox>
                        </VBox>

                    </HBox>

                    <!-- Schedule Management Buttons (Only for Team Creator) -->
                    <HBox fx:id="scheduleManagementButtons" spacing="12" alignment="CENTER" 
                          visible="false" managed="false"
                          style="-fx-background-color: rgba(139,13,13,0.1); -fx-border-color: rgba(139,13,13,0.3); -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 16;">
                        
                        <Button onAction="#openGenerateScheduleModal"
                                style="-fx-background-color: #8B0D0D; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 10 18; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 2; -fx-shape: 'M 5 0 L 95 0 L 100 5 L 100 30 L 95 35 L 5 35 L 0 30 L 0 5 Z';"
                                text="▶ Générer Planning" />
                        
                        <Button onAction="#clearAllTrainingSessions"
                                style="-fx-background-color: rgba(139,13,13,0.3); -fx-text-fill: #ff6b6b; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 10 18; -fx-cursor: hand; -fx-border-color: rgba(255,107,107,0.4); -fx-border-width: 2; -fx-shape: 'M 5 0 L 95 0 L 100 5 L 100 30 L 95 35 L 5 35 L 0 30 L 0 5 Z';"
                                text="✖ Effacer Planning" />
                    </HBox>

                    <!-- Calendar View for Training Sessions -->
                    <StackPane fx:id="calendarViewContainer" visible="false" managed="false" />

                </VBox>

                <!-- AUTRES ÉQUIPES overlay — initially hidden -->
                <StackPane fx:id="innerContainer" visible="false" managed="false"
                           style="-fx-background-color: #0d0d1a;" />

            </StackPane>

        </VBox>
    </content>
</ScrollPane>
