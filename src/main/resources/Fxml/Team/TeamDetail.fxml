<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Genex.Controllers.Team.TeamDetailController"
      styleClass="team-detail" stylesheets="@TeamDetail.css"
      spacing="0" style="-fx-background-color: #0a0a1a;">

    <!-- Header with Team Info -->
    <VBox styleClass="detail-header" spacing="16">
        <children>
            <!-- Back Button and Title -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <children>
                    <Button fx:id="btnBack" onAction="#handleBack" styleClass="back-btn" text="← Retour" />
                    <Text fx:id="teamNameTitle" styleClass="page-title" text="Team Name" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Text fx:id="teamTag" styleClass="team-tag-large" text="[TAG]" />
                </children>
            </HBox>

            <!-- Team Info Cards -->
            <HBox spacing="20">
                <children>
                    <VBox styleClass="info-card" spacing="8">
                        <children>
                            <Text styleClass="info-label" text="Jeu" />
                            <Text fx:id="teamGame" styleClass="info-value" text="Game Name" />
                        </children>
                    </VBox>

                    <VBox styleClass="info-card" spacing="8">
                        <children>
                            <Text styleClass="info-label" text="Type" />
                            <Text fx:id="teamType" styleClass="info-value" text="Type" />
                        </children>
                    </VBox>

                    <VBox styleClass="info-card" spacing="8">
                        <children>
                            <Text styleClass="info-label" text="Fondée le" />
                            <Text fx:id="teamFounded" styleClass="info-value" text="Date" />
                        </children>
                    </VBox>
                </children>
            </HBox>
        </children>
    </VBox>

    <!-- Training Sessions Section -->
    <VBox VBox.vgrow="ALWAYS" spacing="0" style="-fx-background-color: #0a0a1a;">
        <children>
            <!-- Section Header -->
            <HBox styleClass="section-header" alignment="CENTER_LEFT" spacing="16">
                <children>
                    <Text styleClass="section-title" text="📅 Séances d'Entraînement" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnAddSession" onAction="#openAddSessionModal" styleClass="primary-btn" text="➕ Nouvelle Séance" />
                </children>
            </HBox>

            <!-- Sessions Container -->
            <StackPane VBox.vgrow="ALWAYS" style="-fx-background-color: #0a0a1a;">
                <children>
                    <!-- Sessions Scroll -->
                    <ScrollPane styleClass="sessions-scroll" fitToWidth="true" fitToHeight="true" style="-fx-background-color: #0a0a1a; -fx-background: #0a0a1a;">
                        <content>
                            <FlowPane fx:id="sessionsContainer" styleClass="sessions-container" hgap="20" vgap="20" style="-fx-background-color: #0a0a1a; -fx-min-height: 100%;">
                                <!-- Training session cards will be added here dynamically -->
                            </FlowPane>
                        </content>
                    </ScrollPane>

                    <!-- Empty State -->
                    <VBox fx:id="emptyState" styleClass="empty-state" alignment="CENTER" spacing="20" visible="false" managed="false" style="-fx-background-color: #0a0a1a;">
                        <children>
                            <Text styleClass="empty-icon" text="📅" />
                            <Text styleClass="empty-text" text="Aucune séance d'entraînement" />
                        </children>
                    </VBox>
                </children>
            </StackPane>
        </children>
    </VBox>

</VBox>