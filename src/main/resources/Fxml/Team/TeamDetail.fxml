<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootStackPane" styleClass="main-content" stylesheets="@PlayerTeams.css"
           xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Genex.Controllers.Team.TeamDetailController">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                style="-fx-background-color: #090918; -fx-background: #090918;">
        <content>
            <VBox fx:id="contentArea" spacing="0"
                  style="-fx-background-color: #090918;">

                <!-- ── Nav Bar ───────────────────────────────────────── -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-background-color: #120812; -fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0; -fx-padding: 12 20 12 20;">
                    <Button fx:id="btnBack" onAction="#handleBack"
                            style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 8 16; -fx-background-radius: 0; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 0;"
                            text="← Retour" />
                    <Label fx:id="teamNameTitle"
                           style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"
                           text="Team Name" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Text fx:id="teamTag"
                          style="-fx-fill: rgba(255,255,255,0.5); -fx-font-size: 14px;"
                          text="[ACTIVE]" />
                </HBox>

                <!-- ── Main Content ────────────────────────────────── -->
                <VBox spacing="16">
                    <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>

                    <!-- 50/50 Split -->
                    <HBox spacing="16">

                        <!-- LEFT: Members -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #09070f; -fx-border-color: rgba(139,13,13,0.4); -fx-border-width: 1; -fx-border-radius: 0; -fx-background-radius: 0; -fx-padding: 18;">

                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px; -fx-font-weight: bold;"
                                       text="MEMBRES" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="memberCountLabel" styleClass="player-member-count"
                                       text="0 / 5 membres" />
                            </HBox>

                            <VBox fx:id="membersContainer" spacing="8" />
                        </VBox>

                        <!-- RIGHT: Logo + Jersey + Info -->
                        <VBox spacing="14" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #09070f; -fx-border-color: rgba(139,13,13,0.4); -fx-border-width: 1; -fx-border-radius: 0; -fx-background-radius: 0; -fx-padding: 18;">

                            <!-- Top Row: Logo (Left) + Jersey (Right) -->
                            <HBox spacing="16" alignment="TOP_LEFT">
                                <!-- Logo (Smaller, Left Side) -->
                                <VBox spacing="6" alignment="TOP_CENTER" prefWidth="120">
                                    <Label style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 10px; -fx-font-weight: bold;" text="LOGO" />
                                    <StackPane alignment="CENTER" maxHeight="100" minHeight="100">
                                        <Circle radius="44"
                                                style="-fx-fill: #090918; -fx-stroke: #8B0D0D; -fx-stroke-width: 2;" />
                                        <ImageView fx:id="teamLogoImage" fitWidth="76" fitHeight="76"
                                                   preserveRatio="true">
                                            <clip>
                                                <Circle radius="38" centerX="38" centerY="38" />
                                            </clip>
                                        </ImageView>
                                        <Text fx:id="teamLogoFallback" style="-fx-fill: #8B0D0D; -fx-font-size: 28px;"
                                              text="▶" />
                                    </StackPane>
                                </VBox>

                                <!-- Jersey (Larger, Right Side) -->
                                <VBox spacing="6" alignment="TOP_CENTER" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 10px; -fx-font-weight: bold;" text="MAILLOT" />
                                    <StackPane alignment="CENTER" prefHeight="180" maxHeight="180">
                                        <Rectangle arcWidth="12" arcHeight="12" width="160" height="180"
                                                   style="-fx-fill: #090918; -fx-stroke: #8B0D0D; -fx-stroke-width: 2;" />
                                        <ImageView fx:id="teamJerseyImage" fitWidth="150" fitHeight="170"
                                                   preserveRatio="true">
                                            <clip>
                                                <Rectangle width="150" height="170" arcWidth="10" arcHeight="10" />
                                            </clip>
                                        </ImageView>
                                        <Text fx:id="teamJerseyFallback" style="-fx-fill: #8B0D0D; -fx-font-size: 48px;"
                                              text="👕" />
                                    </StackPane>
                                </VBox>
                            </HBox>

                            <!-- Info rows -->
                            <VBox spacing="3">
                                <Label style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 10px; -fx-font-weight: bold;" text="JEU" />
                                <Label fx:id="teamGame" style="-fx-text-fill: white; -fx-font-size: 13px;" text="—" />
                            </VBox>
                            <VBox spacing="3">
                                <Label style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 10px; -fx-font-weight: bold;" text="CONTACT" />
                                <Label fx:id="teamType" style="-fx-text-fill: white; -fx-font-size: 13px;" text="—" />
                            </VBox>
                            <VBox spacing="3">
                                <Label style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 10px; -fx-font-weight: bold;" text="STATUT" />
                                <Text fx:id="teamStatus" style="-fx-fill: white; -fx-font-size: 13px;" text="—" />
                            </VBox>
                            <VBox spacing="3">
                                <Label style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 10px; -fx-font-weight: bold;" text="FONDÉE LE" />
                                <Text fx:id="teamFounded" style="-fx-fill: white; -fx-font-size: 13px;" text="—" />
                            </VBox>
                        </VBox>
                    </HBox>

                    <!-- Schedule Management Buttons (Admin View) -->
                    <HBox spacing="12" alignment="CENTER"
                          style="-fx-background-color: rgba(139,13,13,0.1); -fx-border-color: rgba(139,13,13,0.3); -fx-border-width: 1; -fx-border-radius: 0; -fx-background-radius: 0; -fx-padding: 16;">
                        
                        <Button onAction="#openGenerateScheduleModal"
                                style="-fx-background-color: #8B0D0D; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 10 18; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 2; -fx-shape: 'M 5 0 L 95 0 L 100 5 L 100 30 L 95 35 L 5 35 L 0 30 L 0 5 Z';"
                                text="▶ Générer Planning" />
                        
                        <Button onAction="#clearAllTrainingSessions"
                                style="-fx-background-color: rgba(139,13,13,0.3); -fx-text-fill: #FF5252; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 10 18; -fx-cursor: hand; -fx-border-color: rgba(255,107,107,0.4); -fx-border-width: 2; -fx-shape: 'M 5 0 L 95 0 L 100 5 L 100 30 L 95 35 L 5 35 L 0 30 L 0 5 Z';"
                                text="✖ Effacer Planning" />
                    </HBox>

                    <!-- Calendar View for Training Sessions -->
                    <StackPane fx:id="calendarViewContainer" />

                </VBox>

            </VBox>
        </content>
    </ScrollPane>

</StackPane>