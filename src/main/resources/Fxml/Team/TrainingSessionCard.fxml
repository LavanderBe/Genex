<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Genex.Controllers.Team.TrainingSessionCardController"
      styleClass="session-card"
      stylesheets="@TrainingSessionCard.css"
      spacing="16"
      alignment="CENTER_LEFT">

    <children>
        <!-- Left Section: Icon and Title -->
        <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="NEVER">
            <children>
                <VBox spacing="4" minWidth="150">
                    <children>
                        <Text fx:id="sessionTitle" styleClass="session-title" text="Session Title" />
                        <Text fx:id="sessionType" styleClass="session-type-label" text="TEAM_PRACTICE" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Middle Section: Info Boxes in a Row -->
        <HBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <children>
                <!-- Date Box -->
                <VBox styleClass="info-box" spacing="4" HBox.hgrow="ALWAYS">
                    <children>
                        <Text styleClass="info-box-label" text="DATE" />
                        <Text fx:id="sessionDate" styleClass="info-box-value" text="29/04/2026" />
                    </children>
                </VBox>

                <!-- Time Box -->
                <VBox styleClass="info-box" spacing="4" HBox.hgrow="ALWAYS">
                    <children>
                        <Text styleClass="info-box-label" text="HORAIRE" />
                        <Text fx:id="sessionDuration" styleClass="info-box-value" text="14:00 - 19:00" />
                    </children>
                </VBox>

                <!-- Duration Box -->
                <VBox styleClass="info-box" spacing="4" HBox.hgrow="ALWAYS">
                    <children>
                        <Text styleClass="info-box-label" text="DURÉE" />
                        <Text fx:id="sessionDurationText" styleClass="info-box-value" text="2h 00min" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Right Section: Status and Actions -->
        <VBox spacing="10" alignment="CENTER" HBox.hgrow="NEVER">
            <children>
                <!-- Status Badge -->
                <StackPane fx:id="statusBadge" styleClass="status-badge">
                    <children>
                        <Text fx:id="sessionStatus" styleClass="status-text" text="PLANNED" />
                    </children>
                </StackPane>

                <!-- Actions -->
                <HBox spacing="8" alignment="CENTER">
                    <children>
                        <Button fx:id="btnEdit" onAction="#handleEdit" styleClass="session-btn-edit" text="Modifier" />
                        <Button fx:id="btnDelete" onAction="#handleDelete" styleClass="session-btn-delete" text="×" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>

</HBox>