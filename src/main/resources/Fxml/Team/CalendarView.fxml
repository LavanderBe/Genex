<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.ColumnConstraints?>

<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Genex.Controllers.Team.CalendarViewController"
      stylesheets="@PlayerTeams.css"
      spacing="20"
      VBox.vgrow="ALWAYS"
      style="-fx-background-color: #09070f; -fx-border-color: rgba(139,13,13,0.4); -fx-border-width: 1; -fx-border-radius: 0; -fx-background-radius: 0; -fx-padding: 24;">

    <!-- Header with Month Navigation -->
    <HBox alignment="CENTER" spacing="16">
        <Button fx:id="btnPrevMonth" text="◀" 
                styleClass="calendar-nav-btn"
                onAction="#handlePrevMonth"
                style="-fx-background-color: rgba(139,13,13,0.3); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 0; -fx-cursor: hand; -fx-border-color: rgba(139,13,13,0.6); -fx-border-width: 1; -fx-border-radius: 0;" />
        
        <Region HBox.hgrow="ALWAYS" />
        
        <Label fx:id="monthYearLabel" 
               style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"
               text="Janvier 2026" />
        
        <Region HBox.hgrow="ALWAYS" />
        
        <Button fx:id="btnNextMonth" text="▶" 
                styleClass="calendar-nav-btn"
                onAction="#handleNextMonth"
                style="-fx-background-color: rgba(139,13,13,0.3); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 0; -fx-cursor: hand; -fx-border-color: rgba(139,13,13,0.6); -fx-border-width: 1; -fx-border-radius: 0;" />
    </HBox>

    <!-- Day of Week Headers -->
    <GridPane fx:id="dayHeadersGrid" hgap="10" vgap="10">
        <padding><Insets top="8" /></padding>
    </GridPane>

    <!-- Calendar Grid -->
    <GridPane fx:id="calendarGrid" hgap="10" vgap="10" VBox.vgrow="ALWAYS">
    </GridPane>

</VBox>
