<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Genex.Controllers.Team.SessionDetailsPanelController"
           style="-fx-background-color: rgba(0,0,0,0.7);"
           alignment="CENTER">

    <!-- Panel Container -->
    <VBox spacing="0" maxWidth="560" maxHeight="540"
          style="-fx-background-color: #1a1a2e; -fx-border-color: rgba(139,13,13,0.6); -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12;">

        <!-- Header with Close Button -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #12122a; -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 0 0 1 0; -fx-padding: 16 20;">
            
            <Label fx:id="dateLabel" 
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"
                   text="Séances du 15 Mai 2026" />
            
            <Region HBox.hgrow="ALWAYS" />
            
            <Button fx:id="btnClose" text="✕" 
                    onAction="#handleClose"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 18px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 4 8; -fx-background-radius: 6;" />
        </HBox>

        <!-- Content Area -->
        <VBox spacing="16" VBox.vgrow="ALWAYS">
            <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>

            <!-- Add Session Button (only visible for creator) -->
            <Button fx:id="btnAddSession" text="＋  Ajouter une séance" 
                    onAction="#handleAddSession"
                    visible="false" managed="false"
                    style="-fx-background-color: #8B0D0D; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 8;" />

            <!-- Sessions List -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background-color: transparent; -fx-background: transparent;"
                        VBox.vgrow="ALWAYS">
                <VBox fx:id="sessionsContainer" spacing="12" />
            </ScrollPane>

        </VBox>

    </VBox>

</StackPane>
