<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" prefHeight="650" prefWidth="550" styleClass="scroll-pane" stylesheets="@AddTrainingSessionModal.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Genex.Controllers.Team.AddTrainingSessionModalController">

    <VBox spacing="20" styleClass="dialog-root">
        <padding>
            <Insets bottom="30" left="40" right="40" top="30" />
        </padding>

        <Label fx:id="modalTitle" styleClass="dialog-title" text="NOUVELLE SESSION" />

        <GridPane hgap="20" vgap="15">
            <columnConstraints>
                <ColumnConstraints percentWidth="35" />
                <ColumnConstraints percentWidth="65" />
            </columnConstraints>

            <!-- Session Title -->
            <Label text="Titre" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                <TextField fx:id="txtTitle" promptText="Entraînement Stratégique" />
                <Label fx:id="errorTitle" managed="false" styleClass="error-label" visible="false" />
            </VBox>

            <!-- Type -->
            <Label text="Type" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                <ChoiceBox fx:id="choiceType" prefWidth="Infinity" />
                <Label fx:id="errorType" managed="false" styleClass="error-label" visible="false" />
            </VBox>

            <!-- Status -->
            <Label text="Statut" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="2">
                <ChoiceBox fx:id="choiceStatus" prefWidth="Infinity" />
                <Label fx:id="errorStatus" managed="false" styleClass="error-label" visible="false" />
            </VBox>

            <!-- Date -->
            <Label text="Date" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="3">
                <DatePicker fx:id="dateSession" prefWidth="Infinity" />
                <Label fx:id="errorDate" managed="false" styleClass="error-label" visible="false" />
            </VBox>

            <!-- Start Time -->
            <Label text="Heure Début" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="4">
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <TextField fx:id="txtStartTime" promptText="HH:MM" HBox.hgrow="ALWAYS" />
                    <VBox spacing="2">
                        <Button text="▲" styleClass="time-btn" onAction="#incrementStartTime" />
                        <Button text="▼" styleClass="time-btn" onAction="#decrementStartTime" />
                    </VBox>
                </HBox>
                <Label fx:id="errorStartTime" managed="false" styleClass="error-label" visible="false" />
            </VBox>

            <!-- End Time -->
            <Label text="Heure Fin" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="5">
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <TextField fx:id="txtEndTime" promptText="HH:MM" HBox.hgrow="ALWAYS" />
                    <VBox spacing="2">
                        <Button text="▲" styleClass="time-btn" onAction="#incrementEndTime" />
                        <Button text="▼" styleClass="time-btn" onAction="#decrementEndTime" />
                    </VBox>
                </HBox>
                <Label fx:id="errorEndTime" managed="false" styleClass="error-label" visible="false" />
            </VBox>

            <!-- Location -->
            <Label text="Lieu" GridPane.columnIndex="0" GridPane.rowIndex="6" />
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="6">
                <TextField fx:id="txtLocation" promptText="Salle d'entraînement" />
            </VBox>

            <!-- Notes -->
            <Label text="Notes" GridPane.columnIndex="0" GridPane.rowIndex="7" />
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="7">
                <TextArea fx:id="txtNotes" promptText="Notes additionnelles..." wrapText="true" prefRowCount="3" />
            </VBox>

            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="15">
            <Button fx:id="btnCancel" onAction="#closeModal" styleClass="secondary-btn" text="Annuler" />
            <Button fx:id="btnSave" onAction="#saveSession" styleClass="primary-btn" text="Créer Session" />
        </HBox>
    </VBox>
</ScrollPane>
