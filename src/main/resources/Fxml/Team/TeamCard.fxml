<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Genex.Controllers.Team.TeamCardController"
      styleClass="team-card"
      stylesheets="@TeamCard.css"
      spacing="16"
      onMouseClicked="#handleCardClick">

    <children>
        <!-- Header -->
        <VBox styleClass="team-card-header" spacing="8" alignment="CENTER">
            <children>
                <!-- Team Logo -->
                <StackPane styleClass="team-logo-container">
                    <children>
                        <Circle radius="40" styleClass="team-logo-circle" />
                        <ImageView fx:id="teamLogo" fitWidth="70" fitHeight="70" preserveRatio="true" styleClass="team-logo-image">
                            <clip>
                                <Circle radius="35" centerX="35" centerY="35" />
                            </clip>
                        </ImageView>
                        <!-- Fallback icon if no logo -->
                        <Text fx:id="teamIconFallback" styleClass="team-icon" text="👥" visible="false" />
                    </children>
                </StackPane>

                <Text fx:id="teamName" styleClass="team-name" text="Team Name" />
                <Text fx:id="teamTag" styleClass="team-tag" text="[TAG]" />
            </children>
        </VBox>

        <!-- Info -->
        <VBox spacing="8">
            <children>
                <HBox styleClass="team-info-row" spacing="8">
                    <children>
                        <Text styleClass="team-info-label" text="🎮" />
                        <Text fx:id="teamGame" styleClass="team-info-value" text="Game" />
                    </children>
                </HBox>

                <HBox styleClass="team-info-row" spacing="8">
                    <children>
                        <Text styleClass="team-info-label" text="📋" />
                        <Text fx:id="teamType" styleClass="team-info-value" text="Type" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Actions -->
        <HBox spacing="8" alignment="CENTER">
            <children>
                <Button fx:id="btnView" onAction="#handleView" styleClass="card-action-btn" text="👁️ Voir" />
                <Button fx:id="btnEdit" onAction="#handleEdit" styleClass="card-action-btn-edit" text="✏️ Modifier" />
                <Button fx:id="btnDelete" onAction="#handleDelete" styleClass="card-action-btn-delete" text="🗑️" />
            </children>
        </HBox>
    </children>

</VBox>