<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Genex.Controllers.Team.TeamChatPanelController"
           style="-fx-background-color: rgba(0, 0, 0, 0.7);"
           onMouseClicked="#handleBackgroundClick">

    <!-- Chat Modal Panel (Slide from right) -->
    <VBox fx:id="chatModalPanel" 
          spacing="0"
          maxWidth="450"
          prefWidth="450"
          styleClass="chat-modal-panel"
          stylesheets="@TeamChat.css"
          StackPane.alignment="CENTER_RIGHT"
          onMouseClicked="#consumeClick">

        <!-- Header with Close Button -->
        <HBox styleClass="chat-modal-header" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="16" right="20" bottom="16" left="20" />
            </padding>
            
            <Label text="💬 Chat d'Équipe" styleClass="chat-modal-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="onlineCountLabel" text="0 membres" styleClass="chat-online-count" />
            <Button fx:id="closeButton" text="✕" 
                    styleClass="chat-close-btn"
                    onAction="#handleClose" />
        </HBox>

        <!-- Messages Area -->
        <ScrollPane fx:id="messagesScrollPane" fitToWidth="true" 
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="messages-scroll-pane"
                    VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="messagesContainer" spacing="8" styleClass="messages-container">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

        <!-- Input Area -->
        <VBox styleClass="chat-input-area" spacing="12">
            <padding>
                <Insets top="12" right="16" bottom="16" left="16" />
            </padding>
            
            <TextArea fx:id="messageInput" 
                      promptText="Tapez un message..."
                      wrapText="true"
                      prefRowCount="2"
                      styleClass="message-input" />
            
            <Button fx:id="sendButton" text="ENVOYER" 
                    styleClass="chat-send-btn"
                    onAction="#handleSendMessage"
                    maxWidth="Infinity" />
        </VBox>

    </VBox>

</StackPane>
