<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Genex.Controllers.Tournament.TournamentCardController"
      styleClass="tournament-card" stylesheets="@TournamentCard.css"
      spacing="0" prefWidth="280" prefHeight="280">

   <!-- Card Header with Icon and Status -->
   <HBox styleClass="card-header" alignment="CENTER">
      <children>
         <StackPane styleClass="tournament-icon-container">
            <children>
               <Text styleClass="tournament-icon" text="🏆" />
            </children>
         </StackPane>
      </children>
   </HBox>

   <!-- Card Body -->
   <VBox styleClass="card-body" spacing="16" VBox.vgrow="ALWAYS">
      <children>
         <!-- Tournament Name -->
         <VBox spacing="6">
            <children>
               <Text fx:id="txtName" styleClass="tournament-name" text="Champions League" textAlignment="CENTER" wrappingWidth="240" />
               <StackPane fx:id="statusBadge" styleClass="status-badge" alignment="CENTER">
                  <children>
                     <Text fx:id="txtStatus" styleClass="status-text" text="ACTIF" />
                  </children>
               </StackPane>
            </children>
         </VBox>

         <!-- Spacer -->
         <Region VBox.vgrow="ALWAYS" />

         <!-- Key Details -->
         <VBox spacing="10">
            <children>
               <!-- Prize Pool -->
               <HBox spacing="8" alignment="CENTER" styleClass="detail-row">
                  <children>
                     <Text styleClass="detail-icon" text="💰" />
                     <Text fx:id="txtPrize" styleClass="detail-value" text="50,000 €" />
                  </children>
               </HBox>

               <!-- Format -->
               <HBox spacing="8" alignment="CENTER" styleClass="detail-row">
                  <children>
                     <Text styleClass="detail-icon" text="📋" />
                     <Text fx:id="txtFormat" styleClass="detail-value" text="Single Elimination" />
                  </children>
               </HBox>

               <!-- Dates -->
               <HBox spacing="8" alignment="CENTER" styleClass="detail-row">
                  <children>
                     <Text styleClass="detail-icon" text="📅" />
                     <Text fx:id="txtDates" styleClass="detail-value" text="15 - 20 Mai" />
                  </children>
               </HBox>
            </children>
         </VBox>
      </children>
   </VBox>

   <!-- Card Footer with Actions -->
   <HBox styleClass="card-footer" spacing="8" alignment="CENTER">
      <children>
         <Button fx:id="btnView" onAction="#handleView" styleClass="action-btn, view-btn" text="Voir" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
         <Button fx:id="btnEdit" onAction="#handleEdit" styleClass="action-btn, icon-btn" text="✏️" />
         <Button fx:id="btnDelete" onAction="#handleDelete" styleClass="action-btn, icon-btn, delete-icon-btn" text="🗑️" />
      </children>
   </HBox>

</VBox>
