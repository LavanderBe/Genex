<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.web.WebView?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Genex.Controllers.Tournament.TournamentDetailController"
      styleClass="tournament-detail-container" stylesheets="@TournamentDetail.css"
      spacing="0" prefWidth="1200" prefHeight="800">

   <!-- Header Section -->
   <HBox styleClass="detail-header" alignment="CENTER_LEFT" spacing="20">
      <padding>
         <Insets top="30" right="40" bottom="30" left="40" />
      </padding>
      <children>
         <!-- Back Button -->
         <Button fx:id="btnBack" onAction="#handleBack" styleClass="btn-back" text="← Retour" />
         
         <Region HBox.hgrow="ALWAYS" />
         
         <!-- Reset Button (Admin only, for testing) -->
         <Button fx:id="btnReset" onAction="#handleReset" styleClass="btn-reset" text="🔄 RESET" visible="false" managed="false" />
         
         <!-- Start Button (Admin only, after sync) -->
         <Button fx:id="btnStart" onAction="#handleStart" styleClass="btn-start" text="DÉMARRER" visible="false" managed="false" />
         
         <!-- Join/Leave Button (Player only) -->
         <Button fx:id="btnJoinLeave" onAction="#handleJoinLeave" styleClass="btn-join" text="REJOINDRE" visible="false" managed="false" />
      </children>
   </HBox>

   <!-- Content Section -->
   <ScrollPane styleClass="detail-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
      <content>
         <VBox spacing="30">
            <padding>
               <Insets top="20" right="40" bottom="40" left="40" />
            </padding>
            <children>
               <!-- Tournament Info Card -->
               <VBox styleClass="info-card" spacing="20">
                  <padding>
                     <Insets top="30" right="30" bottom="30" left="30" />
                  </padding>
                  <children>
                     <!-- Title and Status -->
                     <HBox alignment="CENTER_LEFT" spacing="20">
                        <children>
                           <Text styleClass="tournament-icon-large" text="🏆" />
                           <VBox spacing="8" HBox.hgrow="ALWAYS">
                              <children>
                                 <Text fx:id="txtTournamentName" styleClass="tournament-title" text="Champions League 2026" />
                                 <Text fx:id="txtGameName" styleClass="game-subtitle" text="Valorant" />
                              </children>
                           </VBox>
                           <StackPane fx:id="statusBadge" styleClass="status-badge-large" alignment="CENTER">
                              <children>
                                 <Text fx:id="txtStatus" styleClass="status-text-large" text="INSCRIPTION OUVERTE" />
                              </children>
                           </StackPane>
                        </children>
                     </HBox>

                     <!-- Details Grid -->
                     <HBox spacing="40" styleClass="info-grid">
                        <children>
                           <!-- Prize Pool -->
                           <VBox spacing="8" styleClass="info-item">
                              <children>
                                 <HBox spacing="10" alignment="CENTER_LEFT">
                                    <children>
                                       <Text styleClass="info-icon" text="💰" />
                                       <Text styleClass="info-label" text="PRIZE POOL" />
                                    </children>
                                 </HBox>
                                 <Text fx:id="txtPrize" styleClass="info-value" text="50,000 €" />
                              </children>
                           </VBox>

                           <!-- Format -->
                           <VBox spacing="8" styleClass="info-item">
                              <children>
                                 <HBox spacing="10" alignment="CENTER_LEFT">
                                    <children>
                                       <Text styleClass="info-icon" text="📋" />
                                       <Text styleClass="info-label" text="FORMAT" />
                                    </children>
                                 </HBox>
                                 <Text fx:id="txtFormat" styleClass="info-value" text="Single Elimination • Solo" />
                              </children>
                           </VBox>

                           <!-- Dates -->
                           <VBox spacing="8" styleClass="info-item">
                              <children>
                                 <HBox spacing="10" alignment="CENTER_LEFT">
                                    <children>
                                       <Text styleClass="info-icon" text="📅" />
                                       <Text styleClass="info-label" text="DATES" />
                                    </children>
                                 </HBox>
                                 <Text fx:id="txtDates" styleClass="info-value" text="15 - 20 Mai 2026" />
                              </children>
                           </VBox>

                           <!-- Center -->
                           <VBox spacing="8" styleClass="info-item">
                              <children>
                                 <HBox spacing="10" alignment="CENTER_LEFT">
                                    <children>
                                       <Text styleClass="info-icon" text="📍" />
                                       <Text styleClass="info-label" text="CENTRE" />
                                    </children>
                                 </HBox>
                                 <Text fx:id="txtCenter" styleClass="info-value" text="Gaming Arena - Paris" />
                              </children>
                           </VBox>
                        </children>
                     </HBox>
                     
                     <!-- Challonge Link (shown after sync) -->
                     <HBox alignment="CENTER_LEFT" spacing="10">
                        <children>
                           <Text styleClass="info-icon" text="🔗" />
                           <Hyperlink fx:id="linkChallonge" onAction="#handleChallongeLink" styleClass="challonge-link" text="Voir sur Challonge" visible="false" managed="false" />
                        </children>
                     </HBox>
                  </children>
               </VBox>
               
               <!-- Bracket Section (shown after sync) -->
               <VBox fx:id="bracketSection" styleClass="bracket-section" spacing="20" visible="false" managed="false">
                  <children>
                     <!-- Section Header -->
                     <HBox alignment="CENTER_LEFT" spacing="15">
                        <children>
                           <Text styleClass="section-title" text="BRACKET" />
                        </children>
                     </HBox>
                     
                     <!-- Bracket WebView -->
                     <StackPane styleClass="bracket-container">
                        <children>
                           <WebView fx:id="bracketWebView" prefHeight="600" />
                        </children>
                     </StackPane>
                  </children>
               </VBox>
               
               <!-- Player Status Card (Player view only) -->
               <VBox fx:id="playerStatusSection" styleClass="player-status-section" spacing="15" visible="false" managed="false">
                  <children>
                     <Text styleClass="section-title" text="VOTRE STATUT" />
                     <HBox fx:id="statusCard" styleClass="status-card" spacing="15" alignment="CENTER_LEFT">
                        <padding><Insets top="20" right="25" bottom="20" left="25" /></padding>
                        <children>
                           <Text fx:id="txtStatusIcon" styleClass="status-icon-large" text="🟢" />
                           <VBox spacing="5">
                              <children>
                                 <Text fx:id="txtPlayerStatus" styleClass="status-title-text" text="EN COMPÉTITION" />
                                 <Text fx:id="txtStatusDetail" styleClass="status-detail-text" text="" />
                              </children>
                           </VBox>
                        </children>
                     </HBox>
                  </children>
               </VBox>
               
               <!-- Final Rankings Section (shown when tournament COMPLETED) -->
               <VBox fx:id="rankingsSection" styleClass="rankings-section" spacing="15" visible="false" managed="false">
                  <children>
                     <HBox alignment="CENTER_LEFT" spacing="15">
                        <children>
                           <Text styleClass="section-title" text="🏆 CLASSEMENT FINAL" />
                        </children>
                     </HBox>
                     <VBox fx:id="rankingsList" styleClass="rankings-list" spacing="10">
                        <!-- Rankings will be added dynamically -->
                     </VBox>
                  </children>
               </VBox>

               <!-- Participants Section (Admin only) -->
               <VBox fx:id="participantsSection" styleClass="participants-section" spacing="20" visible="false" managed="false">
                  <children>
                     <!-- Section Header -->
                     <HBox alignment="CENTER_LEFT" spacing="15">
                        <children>
                           <Text styleClass="section-title" text="PARTICIPANTS" />
                           <StackPane styleClass="participant-count-badge">
                              <children>
                                 <Text fx:id="txtParticipantCount" styleClass="participant-count-text" text="0" />
                              </children>
                           </StackPane>
                        </children>
                     </HBox>

                     <!-- Participants List -->
                     <VBox fx:id="participantsList" styleClass="participants-list" spacing="12">
                        <!-- Participant cards will be added here dynamically -->
                     </VBox>

                     <!-- Empty State -->
                     <VBox fx:id="emptyParticipants" styleClass="empty-participants" spacing="15" alignment="CENTER" visible="false" managed="false">
                        <children>
                           <Text styleClass="empty-icon" text="👥" />
                           <Text styleClass="empty-text" text="Aucun participant pour le moment" />
                        </children>
                     </VBox>
                     
                     <!-- Sync Button (Admin only, before sync) -->
                     <HBox alignment="CENTER" styleClass="sync-button-container">
                        <children>
                           <Button fx:id="btnSync" onAction="#handleSync" styleClass="btn-sync" text="SYNCHRONISER AVEC CHALLONGE" visible="false" managed="false" />
                        </children>
                     </HBox>
                  </children>
               </VBox>
               
               <!-- Matches Section (Admin only, after tournament started) -->
               <VBox fx:id="matchesSection" styleClass="matches-section" spacing="20" visible="false" managed="false">
                  <children>
                     <!-- Section Header -->
                     <HBox alignment="CENTER_LEFT" spacing="15">
                        <children>
                           <Text styleClass="section-title" text="MATCHES" />
                           <Button fx:id="btnRefreshMatches" onAction="#handleRefreshMatches" styleClass="btn-refresh" text="🔄 ACTUALISER" />
                        </children>
                     </HBox>

                     <!-- Matches List by Round -->
                     <VBox fx:id="matchesList" styleClass="matches-list" spacing="20">
                        <!-- Match rounds will be added here dynamically -->
                     </VBox>

                     <!-- Empty State -->
                     <VBox fx:id="emptyMatches" styleClass="empty-matches" spacing="15" alignment="CENTER" visible="false" managed="false">
                        <children>
                           <Text styleClass="empty-icon" text="🎮" />
                           <Text styleClass="empty-text" text="Aucun match pour le moment" />
                        </children>
                     </VBox>
                  </children>
               </VBox>
            </children>
         </VBox>
      </content>
   </ScrollPane>

</VBox>
