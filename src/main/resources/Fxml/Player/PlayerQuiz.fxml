<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="main-container" stylesheets="@PlayerQuiz.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Genex.Controllers.Player.PlayerQuizController">
    <children>
        <VBox spacing="16.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="section-title" text="CENTRE D'ÉVALUATION" />
                        <Label styleClass="module-subtitle" text="MODULE DE QUIZ" />
                    </children>
                </VBox>
                <TextField fx:id="scanField" styleClass="scan-search-field" text="ANALYSER LES ÉVALUATIONS..." />
                <ScrollPane fitToWidth="true" styleClass="transparent-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="quizContainer" spacing="16.0" />
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
