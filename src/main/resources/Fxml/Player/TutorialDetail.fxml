<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Genex.Controllers.Player.TutorialDetailController"
            stylesheets="@PlayerTutorial.css"
            styleClass="main-container"
            prefWidth="900" prefHeight="720">

    <top>
        <VBox spacing="6" styleClass="detail-popup-top">
            <padding><Insets top="22" right="32" bottom="20" left="32"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label text="[ BRIEFING TACTIQUE ]" styleClass="detail-popup-tag"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕ RETOUR" onAction="#handleClose" styleClass="tutorial-btn-abort"/>
            </HBox>
            <Label fx:id="titleLabel" text="MODULE" styleClass="detail-popup-title"/>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label fx:id="categoryLabel" text="CATÉGORIE" styleClass="detail-popup-meta detail-popup-meta-blue"/>
                <Label text="•" styleClass="detail-separator"/>
                <Label fx:id="difficultyLabel" text="INTENSITÉ" styleClass="detail-popup-meta"/>
                <Label text="•" styleClass="detail-separator"/>
                <Label fx:id="dateLabel" text="DATE" styleClass="detail-popup-meta"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="avgRatingLabel" text="" styleClass="detail-popup-rating"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="transparent-scroll">
            <VBox spacing="18">
                <padding><Insets top="22" right="32" bottom="22" left="32"/></padding>

                <!-- Description -->
                <Label fx:id="descriptionLabel" wrapText="true" styleClass="detail-description"/>

                <!-- Progress block -->
                <VBox spacing="6" styleClass="detail-block">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="PROGRESSION TACTIQUE" styleClass="detail-block-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="progressLabel" text="0%" styleClass="detail-progress-value"/>
                    </HBox>
                    <ProgressBar fx:id="progressBar" prefWidth="9999" progress="0"/>
                    <Label fx:id="videosCountLabel" text="0 / 0 VIDÉOS" styleClass="detail-meta-muted"/>
                </VBox>

                <!-- Videos list -->
                <VBox spacing="8">
                    <Label text="VIDÉOS DU MODULE" styleClass="detail-list-title"/>
                    <VBox fx:id="videosList" spacing="8"/>
                </VBox>

                <!-- Rating block -->
                <VBox fx:id="ratingBlock" spacing="10" styleClass="detail-block">
                    <Label text="ÉVALUER LE MODULE" styleClass="detail-block-title"/>
                    <Label fx:id="ratingHint" text="Terminez toutes les vidéos pour débloquer la notation." wrapText="true" styleClass="detail-hint-muted"/>
                    <HBox fx:id="starsRow" spacing="6"/>
                    <TextArea fx:id="commentField" promptText="Laissez un commentaire (optionnel)..."
                              prefRowCount="3" wrapText="true" styleClass="detail-comment-area"/>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button fx:id="submitRatingBtn" text="VALIDER L'ÉVALUATION" onAction="#handleSubmitRating" styleClass="tutorial-btn-execute"/>
                        <Label fx:id="ratingStatusLabel" text="" styleClass="detail-status-success"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
