<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="video-player-container" stylesheets="@VideoPlayer.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Genex.Controllers.Player.VideoPlayerController">
    <children>
        <VBox spacing="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <children>
                <HBox spacing="10.0" styleClass="video-header" VBox.vgrow="NEVER">
                    <children>
                        <Label fx:id="videoTitleLabel" styleClass="video-title" text="CHARGEMENT..." />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="closeButton" onAction="#handleClose" styleClass="close-button" text="FERMER" />
                    </children>
                </HBox>
                <StackPane fx:id="videoPlayerPane" styleClass="video-player-pane" VBox.vgrow="ALWAYS">
                    <children>
                        <WebView fx:id="webView" />
                        <Label fx:id="loadingLabel" styleClass="loading-message" text="CHARGEMENT DE LA VIDÉO..." />
                        <Label fx:id="errorLabel" styleClass="error-message" text="" visible="false" />
                    </children>
                </StackPane>
                <VBox spacing="8.0" styleClass="video-info-pane" VBox.vgrow="NEVER">
                    <children>
                        <Label fx:id="videoDescriptionLabel" styleClass="video-description" text="" wrapText="true" />
                        <HBox spacing="15.0">
                            <children>
                                <Label fx:id="videoCategoryLabel" styleClass="video-meta" text="" />
                                <Label fx:id="videoDifficultyLabel" styleClass="video-meta" text="" />
                                <Label fx:id="videoDateLabel" styleClass="video-meta" text="" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
