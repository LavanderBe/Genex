<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="main-container" stylesheets="@PlayerTutorial.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Genex.Controllers.Player.PlayerTutorialController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="section-title" text="TRAINING INVENTORY" />
                        <Label styleClass="subtitle" text="DATA STREAM ACTIVE" />
                    </children>
                </VBox>
                <TextField fx:id="searchField" promptText="FILTER MODULES..." styleClass="search-field" />
                <Label fx:id="statusLabel" managed="false" styleClass="status-text" text="" visible="false" />
                <ScrollPane fitToWidth="true" styleClass="transparent-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="tutorialCardsPane" hgap="20.0" prefWrapLength="1080.0" vgap="20.0">
                            <!-- Cards will be injected here -->
                        </FlowPane>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
