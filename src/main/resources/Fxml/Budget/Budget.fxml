<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/23.0.2"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Genex.Controllers.Budget.BudgetController"
           stylesheets="@Budget.css"
           prefWidth="1280" prefHeight="800"
           styleClass="root-pane">

    <!-- ══ BASE LAYOUT ══════════════════════════════════════════════════ -->
    <HBox>

        <!-- ── SIDEBAR ─────────────────────────────────────────────── -->
        <VBox styleClass="sidebar" prefWidth="220" minWidth="220">
            <padding><Insets top="28" right="0" bottom="24" left="0"/></padding>

            <HBox styleClass="sidebar-brand" alignment="CENTER_LEFT" spacing="10">
                <padding><Insets right="20" bottom="24" left="20"/></padding>
                <Label text="⚡" styleClass="brand-icon"/>
                <Label text="GENEX" styleClass="brand-text"/>
            </HBox>

            <Label text="GESTION" styleClass="sidebar-section-label">
                <padding><Insets bottom="6" left="20"/></padding>
            </Label>

            <Button text="🏆  Sponsors" styleClass="sidebar-btn"
                    maxWidth="Infinity" onAction="#goToSponsors"/>
            <Button text="💰  Budgets"  styleClass="sidebar-btn sidebar-btn-active"
                    maxWidth="Infinity" disable="true"/>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox styleClass="sidebar-user" alignment="CENTER_LEFT" spacing="10">
                <padding><Insets top="16" right="20" left="20"/></padding>
                <Label text="GX" styleClass="user-avatar"/>
                <VBox spacing="2">
                    <Label text="Admin" styleClass="user-name"/>
                    <Label text="Genex Platform" styleClass="user-role"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- ── MAIN AREA ───────────────────────────────────────────── -->
        <VBox HBox.hgrow="ALWAYS" styleClass="main-area">

            <!-- Top bar -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <padding><Insets top="18" right="28" bottom="18" left="28"/></padding>
                <VBox spacing="3">
                    <Label text="Gestion des Budgets" styleClass="page-title"/>
                    <Label text="Suivez les budgets par centre et sponsor" styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" styleClass="search-field"
                           promptText="🔍  Rechercher…" prefWidth="240"/>
                <Button text="＋  Ajouter" styleClass="btn-add" onAction="#handleAdd"/>
            </HBox>

            <!-- Stat cards -->
            <HBox spacing="16" styleClass="stat-row">
                <padding><Insets top="20" right="28" bottom="20" left="28"/></padding>
                <VBox styleClass="stat-card stat-purple" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="4">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="📋  Total" styleClass="stat-icon-label"/>
                    <Label fx:id="statTotal" text="0" styleClass="stat-number"/>
                    <Label text="Budgets" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card stat-green" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="4">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="✅  Alloué" styleClass="stat-icon-label"/>
                    <Label fx:id="statAllocated" text="0 TND" styleClass="stat-number"/>
                    <Label text="Total alloué" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card stat-orange" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="4">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="💸  Dépensé" styleClass="stat-icon-label"/>
                    <Label fx:id="statSpent" text="0 TND" styleClass="stat-number"/>
                    <Label text="Total dépensé" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card stat-blue" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="4">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="💰  Restant" styleClass="stat-icon-label"/>
                    <Label fx:id="statRemaining" text="0 TND" styleClass="stat-number"/>
                    <Label text="Total restant" styleClass="stat-label"/>
                </VBox>
            </HBox>

            <!-- Table + Chart -->
            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <padding><Insets right="28" bottom="24" left="28"/></padding>

                <!-- Table panel -->
                <VBox styleClass="panel" spacing="10" HBox.hgrow="ALWAYS">
                    <Label text="Liste des budgets" styleClass="panel-title"/>
                    <TableView fx:id="budgetTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="colCenter"    text="Centre"        prefWidth="160"/>
                            <TableColumn fx:id="colSponsor"   text="Sponsor"       prefWidth="130"/>
                            <TableColumn fx:id="colYear"      text="Année"         prefWidth="65"/>
                            <TableColumn fx:id="colAllocated" text="Alloué"        prefWidth="110"/>
                            <TableColumn fx:id="colSpent"     text="Dépensé"       prefWidth="110"/>
                            <TableColumn fx:id="colRemaining" text="Restant"       prefWidth="110"/>
                            <TableColumn fx:id="colActions"   text=""              prefWidth="80"/>
                        </columns>
                        <placeholder>
                            <Label text="Aucun budget enregistré" styleClass="table-placeholder"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Chart panel — coming soon -->
                <VBox styleClass="panel" spacing="10" prefWidth="270" minWidth="250">
                    <Label text="Alloué vs Dépensé" styleClass="panel-title"/>
                    <Label text="📊  Graphiques disponibles prochainement"
                           styleClass="table-placeholder" VBox.vgrow="ALWAYS"
                           wrapText="true"/>
                </VBox>
            </HBox>

        </VBox>
    </HBox>

    <!-- ══ DRAWER OVERLAY ═══════════════════════════════════════════════ -->
    <StackPane fx:id="drawerOverlay" styleClass="overlay-bg"
               visible="false" managed="false" alignment="CENTER_RIGHT">

        <VBox styleClass="drawer" prefWidth="380" maxWidth="380"
              StackPane.alignment="CENTER_RIGHT">
            <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

            <HBox alignment="CENTER_LEFT">
                <Label fx:id="formTitle" text="Nouveau budget" styleClass="drawer-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" styleClass="btn-close" onAction="#handleClear"/>
            </HBox>

            <Separator styleClass="drawer-sep">
                <VBox.margin><Insets top="12" bottom="16"/></VBox.margin>
            </Separator>

            <!-- Center ID -->
            <VBox spacing="6">
                <VBox.margin><Insets bottom="10"/></VBox.margin>
                <Label text="ID du Centre *" styleClass="field-label"/>
                <TextField fx:id="fieldCenterId" styleClass="input-field" promptText="UUID du centre"/>
                <Label fx:id="errCenter" styleClass="err-label" visible="false" managed="false"/>
            </VBox>

            <!-- Sponsor -->
            <VBox spacing="6">
                <VBox.margin><Insets bottom="10"/></VBox.margin>
                <Label text="Sponsor (optionnel)" styleClass="field-label"/>
                <ComboBox fx:id="combSponsor" styleClass="combo-field"
                          promptText="— Fonds internes —" maxWidth="Infinity"/>
            </VBox>

            <!-- Fiscal year -->
            <VBox spacing="6">
                <VBox.margin><Insets bottom="10"/></VBox.margin>
                <Label text="Année fiscale *" styleClass="field-label"/>
                <TextField fx:id="fieldYear" styleClass="input-field" promptText="Ex: 2025"/>
                <Label fx:id="errYear" styleClass="err-label" visible="false" managed="false"/>
            </VBox>

            <!-- Allocated -->
            <VBox spacing="6">
                <VBox.margin><Insets bottom="10"/></VBox.margin>
                <Label text="Montant alloué (TND) *" styleClass="field-label"/>
                <TextField fx:id="fieldAllocated" styleClass="input-field" promptText="Ex: 50000.00"/>
                <Label fx:id="errAllocated" styleClass="err-label" visible="false" managed="false"/>
            </VBox>

            <!-- Spent -->
            <VBox spacing="6">
                <VBox.margin><Insets bottom="10"/></VBox.margin>
                <Label text="Montant dépensé (TND)" styleClass="field-label"/>
                <TextField fx:id="fieldSpent" styleClass="input-field" promptText="0.00"/>
            </VBox>

            <!-- Logo file picker -->
            <VBox spacing="6">
                <VBox.margin><Insets bottom="14"/></VBox.margin>
                <Label text="Justificatif (PNG / JPEG)" styleClass="field-label"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="fieldDoc" styleClass="input-field"
                               promptText="Choisir un fichier…"
                               editable="false" HBox.hgrow="ALWAYS"/>
                    <Button text="📁" styleClass="btn-pick" onAction="#handlePickDoc"/>
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox spacing="10">
                <Button fx:id="btnSave" text="Enregistrer" styleClass="btn-primary"
                        onAction="#handleSave" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="44"/>
                <Button text="Annuler" styleClass="btn-secondary"
                        onAction="#handleClear" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="44"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
