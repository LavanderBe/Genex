<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: transparent;" stylesheets="@Games_admin.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Genex.Controllers.Games.Games">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
            <children>

                <!-- HEADER -->
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <VBox>
                            <children>
                                <Label styleClass="module-title" text="NEURAL_LINK // GAMES_DATABASE" textFill="WHITE" />
                                <Label style="-fx-font-size: 9px; -fx-letter-spacing: 2px;" text="MANAGE_VIRTUAL_ENTITIES" textFill="#5c7cfa" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#openAddOverlay" styleClass="action-blue-button" text="+ REGISTER_NEW_ENTRY" />
                    </children>
                </HBox>

                <!-- GRID AREA -->
                <ScrollPane fitToWidth="true" styleClass="edge-scrollpane" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="gamesGrid" hgap="25.0" style="-fx-padding: 10;" vgap="25.0">
                            <!-- Game Cards will be injected here via Controller -->
                        </FlowPane>
                    </content>
                </ScrollPane>
            </children>
        </VBox>

        <!-- ADD GAME OVERLAY (CYBER MODAL) -->
        <!-- THE OVERLAY SHIELD -->
        <StackPane fx:id="addGameOverlay" managed="false" style="-fx-background-color: rgba(0,0,0,0.88);" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="420.0" prefWidth="750.0" styleClass="compact-shard">
                    <children>
                        <!-- Background Hardware Plate -->
                        <SVGPath content="M 0 0 L 710 0 L 750 40 L 750 420 L 40 420 L 0 380 Z" fill="#050508" stroke="#8B0D0D" strokeWidth="1.5" />

                        <!-- Side Red Accent Bar -->
                        <Region layoutX="0" layoutY="100" prefHeight="220" prefWidth="3" style="-fx-background-color: #8B0D0D;" />

                        <HBox layoutX="30.0" layoutY="30.0" prefHeight="360.0" prefWidth="690.0" spacing="30.0">
                            <children>

                                <!-- LEFT SIDE: SYSTEM INPUTS -->
                                <VBox prefWidth="400.0" spacing="12.0">
                                    <children>
                                        <VBox>
                                            <children>
                                                <Label style="-fx-font-family: 'Arial Black'; -fx-font-size: 18px;" text="GENEX // SYSTEM" textFill="WHITE" />
                                                <Label style="-fx-font-size: 9px; -fx-letter-spacing: 2px;" styleClass="TITLE" text="INITIALISATION_JEU" textFill="#5c7cfa" />
                                            </children>
                                            <padding><Insets bottom="10" /></padding>
                                        </VBox>

                                        <TextField fx:id="nomField" promptText="NOM DU JEU" styleClass="hud-input" />
                                        <TextField fx:id="genreField" promptText="GENRE (FPS, MOBA, etc.)" styleClass="hud-input" />

                                        <HBox spacing="10">
                                            <children>
                                                <ComboBox fx:id="platformCombo" prefWidth="195.0" promptText="PLATFORME" styleClass="hud-combo" />
                                                <ComboBox fx:id="modeCombo" prefWidth="195.0" promptText="MODE" styleClass="hud-combo" />
                                            </children>
                                        </HBox>

                                        <TextField fx:id="maxPlayersField" promptText="MAX_JOUEURS" styleClass="hud-input" />
                                        <Label fx:id="errorLabelAdd" alignment="CENTER" prefHeight="25.0" prefWidth="397.0" textAlignment="CENTER" textFill="#8b0d0d" />

                                        <Region VBox.vgrow="ALWAYS" />

                                        <HBox spacing="15.0">
                                            <children>
                                                <Button onAction="#handleSaveGame" prefHeight="40.0" prefWidth="240.0" styleClass="confirm-btn" text="COMMENCE_UPLOAD" />
                                                <Button onAction="#closeOverlay" prefHeight="40.0" prefWidth="140.0" styleClass="cancel-btn" text="ABORT" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- RIGHT SIDE: ASSET PREVIEW -->
                                <VBox alignment="TOP_CENTER" prefWidth="260.0" spacing="15.0" style="-fx-background-color: rgba(31, 30, 78, 0.1); -fx-border-color: rgba(139, 13, 13, 0.3); -fx-border-width: 0 0 0 1;">
                                    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                                    <children>
                                        <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="ASSET_PREVIEW" textFill="#8B0D0D" />

                                        <!-- The Icon Preview Area -->
                                        <StackPane prefHeight="180.0" prefWidth="180.0" style="-fx-border-color: #1F1E4E; -fx-border-style: dashed;">
                                            <children>
                                                <ImageView fx:id="iconPreview" fitHeight="170.0" fitWidth="170.0" pickOnBounds="true" preserveRatio="true" />
                                                <Label fx:id="placeholderLabel" text="NO_IMAGE" textFill="#1F1E4E" />
                                            </children>
                                        </StackPane>

                                        <Button onAction="#handleChooseIcon" prefWidth="200.0" styleClass="upload-btn" text="SELECT_IMAGE_FILE" />

                                        <VBox spacing="5">
                                            <children>
                                                <Label style="-fx-font-size: 8px;" text="FILE_STATUS:" textFill="#444466" />
                                                <Label fx:id="iconPathLabel" style="-fx-font-size: 9px;" text="WAITING_FOR_DATA..." textFill="#5c7cfa" wrapText="true" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </AnchorPane>
            </children>
        </StackPane>
    </children>
</AnchorPane>
