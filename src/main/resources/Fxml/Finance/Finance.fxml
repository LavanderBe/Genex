<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns="http://javafx.com/javafx/23.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Genex.Controllers.Finance.FinanceController"
      stylesheets="@Finance.css"
      styleClass="finance-root">

    <!-- ── Finance header bar with page selector ─────────────────────── -->
    <HBox styleClass="finance-header" alignment="CENTER_LEFT" spacing="20">
        <padding><Insets top="14" right="28" bottom="14" left="28"/></padding>

        <!-- Section label -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <SVGPath styleClass="finance-icon"
                     content="M9.5 3C11.9853 3 14 7.02944 14 12M9.5 3C7.01472 3 5 7.02944 5 12C5 16.9706 7.01472 21 9.5 21M9.5 3H15C17.2091 3 19 7.02944 19 12M14 12C14 16.9706 11.9853 21 9.5 21M14 12H19M9.5 21H15C17.2091 21 19 16.9706 19 12M18.3264 17H13.2422M18.3264 7H13.2422M9.5 8C10.3284 8 11 9.79086 11 12C11 14.2091 10.3284 16 9.5 16C8.67157 16 8 14.2091 8 12C8 9.79086 8.67157 8 9.5 8Z"/>
            <Label text="FINANCES" styleClass="finance-section-title"/>
        </HBox>

        <Label text="/" styleClass="finance-sep"/>

        <!-- Page selector ComboBox -->
        <ComboBox fx:id="pageSelector"
                  styleClass="finance-combo"
                  promptText="— Sélectionner une page —"
                  prefWidth="240"
                  onAction="#handlePageChange"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Breadcrumb indicator -->
        <Label fx:id="breadcrumb" text="FINANCES" styleClass="finance-breadcrumb"/>
    </HBox>

    <!-- Thin red accent line -->
    <Region prefHeight="2" styleClass="finance-accent-line"/>

    <!-- ── Sub-view content area ──────────────────────────────────────── -->
    <StackPane fx:id="financeContent" VBox.vgrow="ALWAYS" styleClass="finance-content"/>

</VBox>
