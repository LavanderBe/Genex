<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Genex.Controllers.Main.NotificationPanelController"
      styleClass="notification-panel" stylesheets="@NotificationPanel.css">
    <children>
        <!-- Panel Header -->
        <HBox alignment="CENTER_LEFT" styleClass="notification-panel-header">
            <children>
                <Text styleClass="notification-panel-title" text="Notifications" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnCloseNotifications" onAction="#closePanel" styleClass="close-notification-btn" text="✕" />
            </children>
        </HBox>

        <!-- Notifications List -->
        <ScrollPane styleClass="notification-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="notificationList" spacing="10.0" styleClass="notification-list" />
            </content>
        </ScrollPane>
    </children>
</VBox>