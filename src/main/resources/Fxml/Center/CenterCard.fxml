<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Button?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Genex.Controllers.Center.CenterCardController"
      styleClass="center-card"
      stylesheets="@CenterCard.css"
      spacing="16"
      onMouseClicked="#handleCardClick">
   
   <children>
      <!-- Header -->
      <VBox styleClass="center-card-header" spacing="8">
         <children>
            <Text styleClass="center-icon" text="🏢" />
            <Text fx:id="centerName" styleClass="center-name" text="Centre Name" />
            <Text fx:id="centerCity" styleClass="center-city" text="City" />
         </children>
      </VBox>
      
      <!-- Info -->
      <VBox spacing="8">
         <children>
            <HBox styleClass="center-info-row" spacing="8">
               <children>
                  <Text styleClass="center-info-label" text="📍" />
                  <Text fx:id="centerAddress" styleClass="center-info-value" text="Address" />
               </children>
            </HBox>
            
            <HBox styleClass="center-info-row" spacing="8">
               <children>
                  <Text styleClass="center-info-label" text="✉️" />
                  <Text fx:id="centerEmail" styleClass="center-info-value" text="Email" />
               </children>
            </HBox>
         </children>
      </VBox>
      
      <!-- Actions -->
      <HBox spacing="8" alignment="CENTER">
         <children>
            <Button fx:id="btnViewMap" onAction="#handleViewMap" styleClass="card-action-btn" text="🗺️ Carte" />
            <Button fx:id="btnEdit" onAction="#handleEdit" styleClass="card-action-btn-edit" text="✏️ Modifier" />
            <Button fx:id="btnDelete" onAction="#handleDelete" styleClass="card-action-btn-delete" text="🗑️" />
         </children>
      </HBox>
   </children>
   
</VBox>
