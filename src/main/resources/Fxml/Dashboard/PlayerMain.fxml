<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="466.0" prefWidth="1376.0" spacing="28" style="-fx-background-color: transparent;" stylesheets="@Playermain.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Genex.Controllers.Dashboard.PlayerMainController">
    <padding><Insets bottom="36" left="40" right="40" top="36" /></padding>

    <!-- Title -->
    <Label text="TERMINAL // PLAYER_HUB" textFill="WHITE">
        <font><Font name="Impact" size="32.0" /></font>
    </Label>

    <HBox prefHeight="100.0" prefWidth="200.0" spacing="50.0">
        <children>

            <!-- Exchange widget -->
            <HBox maxWidth="980.0" prefHeight="206.0" prefWidth="980.0" spacing="0" style="-fx-background-color: rgba(0,0,0,0.55); -fx-border-color: #8B0D0D; -fx-border-width: 1;">

                <!-- LEFT: live rates list -->
                <VBox minWidth="360" prefWidth="420.0">
                    <HBox style="-fx-background-color: rgba(139,13,13,0.25); -fx-padding: 9 14;">
                        <Label style="-fx-font-family: Impact; -fx-font-size: 13px; -fx-letter-spacing: 1px;" text="TAUX DE CHANGE — EN DIRECT" textFill="#ff4d4d" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="exchangeLastUpdate" style="-fx-text-fill: rgba(255,255,255,0.3); -fx-font-size: 10px;" text="—" />
                    </HBox>
                    <ListView fx:id="exchangeRatesList" focusTraversable="false" prefHeight="168.0" prefWidth="410.0" styleClass="retro-list" />
                </VBox>

                <!-- Divider -->
                <Region prefWidth="1" style="-fx-background-color: rgba(139,13,13,0.4);" />

                <!-- RIGHT: converter -->
                <VBox minWidth="280" prefHeight="205.0" prefWidth="577.0" spacing="0">
                    <HBox prefHeight="35.0" prefWidth="643.0" style="-fx-background-color: rgba(139,13,13,0.25); -fx-padding: 9 14;">
                        <Label prefHeight="18.0" prefWidth="95.0" style="-fx-font-family: Impact; -fx-font-size: 13px; -fx-letter-spacing: 1px;" text="CONVERTISSEUR" textFill="#ff4d4d" />
                    </HBox>
                    <VBox prefHeight="170.0" prefWidth="610.0" spacing="12" style="-fx-padding: 16 18;">
                        <!-- Amount + from + to -->
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <TextField fx:id="convertAmount" prefHeight="36" prefWidth="98.0" promptText="Montant" style="-fx-background-color: rgba(255,255,255,0.05); -fx-border-color: rgba(139,13,13,0.5); -fx-text-fill: white;" />
                            <ComboBox fx:id="convertFrom" prefHeight="36" prefWidth="81.0" style="-fx-background-color: rgba(255,255,255,0.05);-fx-border-color: rgba(139,13,13,0.5);-fx-border-width: 1;-fx-font-size: 12px;" />
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="→" textFill="#ff4d4d" />
                            <ComboBox fx:id="convertTo" prefHeight="36" prefWidth="80.0" style="-fx-background-color: rgba(255,255,255,0.05);-fx-border-color: rgba(139,13,13,0.5);-fx-border-width: 1;-fx-font-size: 12px;" />

                            <!-- Result box -->
                            <VBox prefHeight="98.0" prefWidth="214.0" spacing="4" style="-fx-background-color: rgba(139,13,13,0.08); -fx-border-color: rgba(139,13,13,0.3); -fx-border-width: 1; -fx-padding: 12 16;">
                                <Label style="-fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 10px;" text="RESULTAT" />
                                <Label fx:id="convertResult" style="-fx-text-fill: #ff4d4d; -fx-font-family: Impact; -fx-font-size: 26px;" text="—" />
                                <Label fx:id="convertRate" style="-fx-text-fill: rgba(255,255,255,0.3); -fx-font-size: 11px;" text="—" />
                            </VBox>
                        </HBox>

                        <!-- Convert button (UPDATED TO MATCH BLUE STYLE) -->
                        <Button onAction="#handleConvert" prefHeight="40" prefWidth="220" styleClass="action-red-button" text="CONVERTIR" />
                    </VBox>
                </VBox>
            </HBox>

            <!-- Play button section -->
            <!-- Play button section wrapped in a rectangle container -->
            <VBox fx:id="playContainer" alignment="CENTER" prefHeight="205.0" prefWidth="266.0" spacing="10" styleClass="play-box-container">
                <children>
                    <!-- Title for the box (Optional, matches your style) -->
                    <Label style="-fx-text-fill: #5c7cfa; -fx-font-family: Impact; -fx-font-size: 10px;" text="SYSTEM_READY" />

                    <Button fx:id="gamebtn" alignment="CENTER" mnemonicParsing="false" onAction="#HandleGame" prefHeight="26.0" prefWidth="146.0" styleClass="action-blue-button" text="Play The Game" textAlignment="CENTER" />
                </children>
                <HBox.margin>
                    <Insets />
                </HBox.margin>
            </VBox>
        </children>
    </HBox>
</VBox>
