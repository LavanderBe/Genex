<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="493.0" prefWidth="1078.0" spacing="28" style="-fx-background-color: transparent;" stylesheets="@Playermain.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Genex.Controllers.Dashboard.PlayerMainController">
    <padding><Insets bottom="36" left="40" right="40" top="36" /></padding>

    <!-- Title -->
    <Label text="TERMINAL // PLAYER_HUB" textFill="WHITE">
        <font><Font name="Impact" size="32.0" /></font>
    </Label>
   <HBox prefHeight="100.0" prefWidth="200.0" spacing="50.0">
      <children>
      
          <!-- Exchange widget — split: left=rates, right=converter -->
          <HBox maxWidth="900" prefHeight="266.0" prefWidth="820.0" spacing="0" style="-fx-background-color: rgba(0,0,0,0.55); -fx-border-color: #8B0D0D; -fx-border-width: 1;">
      
              <!-- LEFT: live rates list -->
              <VBox minWidth="360" prefWidth="420">
                  <HBox style="-fx-background-color: rgba(139,13,13,0.25); -fx-padding: 9 14;">
                      <Label style="-fx-font-family: Impact; -fx-font-size: 13px; -fx-letter-spacing: 1px;" text="TAUX DE CHANGE — EN DIRECT" textFill="#ff4d4d" />
                      <Region HBox.hgrow="ALWAYS" />
                      <Label fx:id="exchangeLastUpdate" style="-fx-text-fill: rgba(255,255,255,0.3); -fx-font-size: 10px;" text="—" />
                  </HBox>
                  <ListView fx:id="exchangeRatesList" prefHeight="220" style="-fx-background-color: transparent;                              -fx-background: transparent;                              -fx-border-color: transparent;                              -fx-font-family: Consolas, monospace;                              -fx-font-size: 13px;                              -fx-control-inner-background: transparent;" />
              </VBox>
      
              <!-- Divider -->
              <Region prefWidth="1" style="-fx-background-color: rgba(139,13,13,0.4);" />
      
              <!-- RIGHT: converter -->
              <VBox minWidth="280" prefHeight="250.0" prefWidth="352.0" spacing="0">
                  <HBox prefHeight="35.0" prefWidth="365.0" style="-fx-background-color: rgba(139,13,13,0.25); -fx-padding: 9 14;">
                      <Label style="-fx-font-family: Impact; -fx-font-size: 13px; -fx-letter-spacing: 1px;" text="CONVERTISSEUR" textFill="#ff4d4d" />
                  </HBox>
                  <VBox spacing="12" style="-fx-padding: 16 18;">
                      <!-- Amount + from + to -->
                      <HBox alignment="CENTER_LEFT" spacing="8">
                          <TextField fx:id="convertAmount" prefHeight="36" prefWidth="90" promptText="Montant" style="-fx-background-color: rgba(255,255,255,0.05);                                       -fx-border-color: rgba(139,13,13,0.5);                                       -fx-border-width: 1;                                       -fx-text-fill: white;                                       -fx-prompt-text-fill: rgba(255,255,255,0.25);                                       -fx-font-size: 13px;                                       -fx-padding: 6 10;                                       -fx-background-radius: 0;" />
                          <ComboBox fx:id="convertFrom" prefHeight="36" prefWidth="105" style="-fx-background-color: rgba(255,255,255,0.05);                                      -fx-border-color: rgba(139,13,13,0.5);                                      -fx-border-width: 1;                                      -fx-font-size: 12px;" />
                          <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="→" textFill="#ff4d4d" />
                          <ComboBox fx:id="convertTo" prefHeight="36" prefWidth="105" style="-fx-background-color: rgba(255,255,255,0.05);                                      -fx-border-color: rgba(139,13,13,0.5);                                      -fx-border-width: 1;                                      -fx-font-size: 12px;" />
                      </HBox>
      
                      <!-- Convert button -->
                      <Button onAction="#handleConvert" prefHeight="38" prefWidth="200" style="-fx-background-color: #8B0D0D;                                -fx-text-fill: white;                                -fx-font-family: Impact;                                -fx-font-size: 14px;                                -fx-letter-spacing: 1px;                                -fx-cursor: hand;                                -fx-background-radius: 0;                                -fx-effect: dropshadow(gaussian, rgba(139,13,13,0.5), 8, 0, 0, 2);" text="CONVERTIR" />
      
                      <!-- Result box -->
                      <VBox spacing="4" style="-fx-background-color: rgba(139,13,13,0.08);                              -fx-border-color: rgba(139,13,13,0.3);                              -fx-border-width: 1;                              -fx-padding: 12 16;">
                          <Label style="-fx-text-fill: rgba(255,255,255,0.35);                                   -fx-font-size: 10px;                                   -fx-letter-spacing: 1px;" text="RESULTAT" />
                          <Label fx:id="convertResult" style="-fx-text-fill: #ff4d4d;                                   -fx-font-family: Impact;                                   -fx-font-size: 26px;" text="—" />
                          <Label fx:id="convertRate" style="-fx-text-fill: rgba(255,255,255,0.3);                                   -fx-font-size: 11px;" text="—" />
                      </VBox>
                  </VBox>
              </VBox>
      
          </HBox>
         <VBox prefHeight="172.0" prefWidth="127.0">
            <children>
               <Button fx:id="gamebtn" alignment="CENTER" mnemonicParsing="false" onAction="#HandleGame" prefHeight="26.0" prefWidth="146.0" styleClass="action-blue-button" text="Play The Game" textAlignment="CENTER" />
            </children>
            <HBox.margin>
               <Insets top="100.0" />
            </HBox.margin>
         </VBox>
      </children>
   </HBox>
</VBox>
