                                <Region prefHeight="50.0" prefWidth="132.0" VBox.vgrow="ALWAYS" />

                                <Button fx:id="navProfileButton" contentDisplay="TOP" onAction="#showProfile" prefHeight="80.0" prefWidth="150.0" styleClass="nav-button" text="PROFIL">
