<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainPane" prefHeight="850.0" prefWidth="1300.0" styleClass="main-container" stylesheets="@Player_dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Genex.Controllers.Dashboard.PlayerDashboard">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0" styleClass="top-bar">
            <children>
              <Button fx:id="toggleSidebarBtn" onAction="#toggleSidebar" styleClass="menu-toggle-btn" text="☰">
                  <font>
                  <Font name="System Bold" size="20.0" />
               </font>
              </Button>
                <VBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="title-text" text="GENEX // PLAYER" textFill="#8B0D0D">
                            <font><Font name="Impact" size="26.0" /></font>
                        </Label>
                        <Label style="-fx-font-size: 9px; -fx-letter-spacing: 2px;" text="LINK_STATUS: STABLE" textFill="#5c7cfa" />
                    </children>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="25.0">
                    <children>
                        <!-- PING -->
                        <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Label style="-fx-font-size: 10px;" text="PING:" textFill="#444466" />
                                <Label text="24MS" textFill="#22c55e">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Label>
                                <Circle fx:id="pingDot" fill="#22c55e" radius="3.0" />
                            </children>
                        </HBox>

                        <!-- EDGY PROFILE PANEL (Tactical Plate Shape) -->
                        <StackPane onMouseClicked="#handleProfileClick" styleClass="profile-hud-plate">
                            <children>
                                <SVGPath content="M 0 0 L 180 0 L 200 20 L 200 50 L 20 50 L 0 30 Z" fill="#0a0a1a" stroke="#8B0D0D" strokeWidth="1.5" />
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <padding><Insets left="15.0" right="15.0" /></padding>
                                    <children>
                                        <Circle fill="#1F1E4E" radius="14.0" stroke="#8B0D0D" />
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label fx:id="sessionUser" text="NEO_PLAYER" textFill="WHITE">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                                <Label style="-fx-font-size: 8px;" text="OPERATOR_LEVEL 12" textFill="#8B0D0D" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </StackPane>

                        <!-- LOGOUT BUTTON -->
                        <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="logout-btn">
                            <graphic>
                                <SVGPath content="M5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h7v2H5v14h7v2zm11-4l-1.4-1.4l2.6-2.6H9v-2h9.2l-2.6-2.6L16 7l5 5z" fill="#ff5252" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
            <padding><Insets left="30.0" right="30.0" /></padding>
        </HBox>
    </top>

    <!-- FULL HEIGHT SIDEBAR -->
    <left>
        <VBox fx:id="sidebarContainer" prefHeight="770.0" prefWidth="126.0" styleClass="sidebar-container">
            <children>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="770.0" prefWidth="152.0" styleClass="edge-scrollpane" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox alignment="TOP_CENTER" prefHeight="620.0" prefWidth="148.0" spacing="10.0" styleClass="sidebar">
                            <children>
                                <Region prefHeight="20.0" />
                                <Button contentDisplay="TOP" onAction="#showMain" prefHeight="80.0" prefWidth="150.0" styleClass="nav-button-active" text="MAIN MENU">
                                    <graphic><SVGPath content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" fill="#8B0D0D" /></graphic>
                                </Button>
                                <Button contentDisplay="TOP" onAction="#showTeams" prefHeight="80.0" prefWidth="150.0" styleClass="nav-button" text="TEAMS">
                                    <graphic><SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#8B0D0D" /></graphic>
                                </Button>
                                <Button contentDisplay="TOP" onAction="#showTournaments" prefHeight="80.0" prefWidth="150.0" styleClass="nav-button" text="TOURNAMENTS">
                                    <graphic><SVGPath content="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V19H7v2h10v-2h-4v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 10.63 21 8.55 21 8V7c0-1.1-.9-2-2-2z" fill="#8B0D0D" /></graphic>
                                </Button>
                                <Button contentDisplay="TOP" onAction="#showTutorials" prefHeight="80.0" prefWidth="150.0" styleClass="nav-button" text="TUTORIALS">
                                    <graphic><SVGPath content="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z" fill="#8B0D0D" /></graphic>
                                </Button>
                                <Button contentDisplay="TOP" onAction="#showForums" prefHeight="80.0" prefWidth="150.0" styleClass="nav-button" text="FORUMS">
                                    <graphic><SVGPath content="M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1zm-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h10c.55 0 1-.45 1-1z" fill="#8B0D0D" /></graphic>
                                </Button>

                                <Region prefHeight="50.0" prefWidth="132.0" VBox.vgrow="ALWAYS" />

                                <Button contentDisplay="TOP" onAction="#showProfile" prefHeight="80.0" prefWidth="150.0" styleClass="nav-button" text="PROFILE">
                                    <graphic><SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z" fill="#8B0D0D" /></graphic>
                                </Button>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <AnchorPane fx:id="contentArea">
            <children>
                <VBox layoutX="50.0" layoutY="50.0" spacing="25.0">
                    <children>
                        <Label text="TERMINAL // PLAYER_HUB" textFill="WHITE">
                            <font><Font name="Impact" size="36.0" /></font>
                        </Label>
                        <HBox spacing="20.0">
                            <children>
                                <Button prefHeight="50.0" prefWidth="200.0" styleClass="action-confirm-btn" text="JOIN MATCH" />
                                <Button prefHeight="50.0" prefWidth="150.0" styleClass="action-cancel-btn" text="ABORT" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </center>
</BorderPane>
