<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainPane" prefHeight="850.0" prefWidth="1300.0" styleClass="main-container" stylesheets="@Player_dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Genex.Controllers.Dashboard.PlayerDashboard">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0" styleClass="top-bar">
            <children>
              <Button fx:id="toggleSidebarBtn" onAction="#toggleSidebar" styleClass="menu-toggle-btn" text="☰">
                  <font>
                  <Font name="System Bold" size="20.0" />
               </font>
              </Button>
                <VBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="title-text" text="GENEX " textFill="#8B0D0D">
                            <font><Font name="Impact" size="26.0" /></font>
                        </Label>
                        <Label style="-fx-font-size: 9px; -fx-letter-spacing: 2px;" text="LINK_STATUS: STABLE" textFill="#5c7cfa" />
                    </children>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="25.0">
                    <children>
                        <!-- PING -->
                        <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Label fx:id="pingLabel" text="24MS" textFill="#22c55e">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Label>
                                <Circle fx:id="pingDot" fill="#22c55e" radius="3.0" />
                            </children>
                        </HBox>

                        <!-- EDGY PROFILE PANEL (Tactical Plate Shape) -->
                        <StackPane onMouseClicked="#handleProfileClick" styleClass="profile-hud-plate">
                            <children>
                                <SVGPath content="M 0 0 L 180 0 L 200 20 L 200 50 L 20 50 L 0 30 Z" fill="#0a0a1a" stroke="#8B0D0D" strokeWidth="1.5" />
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <padding><Insets left="15.0" right="15.0" /></padding>
                                    <children>
                                        <Circle fill="#1F1E4E" radius="14.0" stroke="#8B0D0D" />
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label fx:id="sessionUser" text="placeholder" textFill="WHITE">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                                <Label style="-fx-font-size: 8px;" text="OPERATOR_LEVEL 12" textFill="#8B0D0D" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </StackPane>

                        <!-- LOGOUT BUTTON -->
                        <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="logout-btn">
                            <graphic>
                                <SVGPath content="M5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h7v2H5v14h7v2zm11-4l-1.4-1.4l2.6-2.6H9v-2h9.2l-2.6-2.6L16 7l5 5z" fill="#ff5252" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
            <padding><Insets left="30.0" right="30.0" /></padding>
        </HBox>
    </top>

    <!-- FULL HEIGHT SIDEBAR -->
    <left>
        <VBox fx:id="sidebarContainer" prefHeight="770.0" prefWidth="126.0" styleClass="sidebar-container">
