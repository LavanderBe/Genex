<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<HBox fx:id="tickerContainer"
      alignment="CENTER_LEFT"
      maxHeight="38.0" minHeight="38.0" prefHeight="38.0"
      style="-fx-background-color: #0a0a14; -fx-border-color: #c0392b transparent transparent transparent; -fx-border-width: 2 0 0 0;"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Genex.Controllers.Dashboard.TournamentNewsTickerController">

    <Label fx:id="liveLabel"
           text="LIVE"
           textFill="WHITE"
           minWidth="70.0" maxWidth="70.0"
           alignment="CENTER"
           style="-fx-background-color: #c0392b; -fx-padding: 0 12 0 12;">
        <font>
            <Font name="System Bold" size="11.0" />
        </font>
    </Label>

    <Region minWidth="1.0" maxWidth="1.0" prefWidth="1.0" prefHeight="38.0"
            style="-fx-background-color: #3a0a0a;" />

    <Pane fx:id="tickerViewport" minHeight="38.0" prefHeight="38.0" HBox.hgrow="ALWAYS">
        <children>
            <Text fx:id="newsText" layoutY="24.0" text="Loading tournament news..." fill="WHITE"
                  style="-fx-font-family: 'System'; -fx-font-weight: bold; -fx-font-size: 13px;" />
        </children>
    </Pane>
</HBox>
