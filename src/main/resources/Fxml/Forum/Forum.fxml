<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Genex.Controllers.Forum.ForumController"
            prefHeight="720.0" prefWidth="1280.0"
            styleClass="main-container"
            stylesheets="@Forum.css">

    <VBox spacing="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <HBox alignment="CENTER" prefHeight="80.0" styleClass="top-nav">
            <HBox alignment="CENTER" spacing="0">
                <Button text="▶ FORUM" styleClass="nav-link, active-link" onAction="#openForum"/>
                <Button text="▶ PUBLICATIONS" styleClass="nav-link" onAction="#openPosts"/>
            </HBox>
        </HBox>

        <VBox spacing="32.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="40" right="60" bottom="40" left="60"/>
            </padding>

            <!-- Header Section -->
            <VBox spacing="8">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="▶" styleClass="campaign-icon"/>
                    <Label text="TERMINAL // ESPACE COMMUNAUTÉ" styleClass="subtitle-label"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="MODULE FORUM" styleClass="title-label"/>
                        <Label text="Créez et gérez les discussions de la communauté. Gardez une communication claire et votre équipe alignée."
                               styleClass="header-desc"/>
                    </VBox>
                    <Button text="+ NOUVEAU FORUM" styleClass="primary-button" onAction="#handleClearForm"/>
                </HBox>
            </VBox>

            <!-- Search and Filters -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <HBox alignment="CENTER_LEFT" styleClass="search-container" HBox.hgrow="ALWAYS">
                    <Label text="🔍" styleClass="search-icon"/>
                    <TextField fx:id="searchField" promptText="Rechercher des forums..." HBox.hgrow="ALWAYS" styleClass="search-input"/>
                </HBox>
                <ComboBox fx:id="categoryFilterField" styleClass="modal-combo" prefWidth="150" promptText="Catégorie"/>
                <ComboBox fx:id="statusFilterField" styleClass="modal-combo" prefWidth="140" promptText="Statut"/>
                <ComboBox fx:id="moderationFilterField" styleClass="modal-combo" prefWidth="150" promptText="Modération"/>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="custom-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="24" styleClass="cards-container">
                    <padding>
                        <Insets top="8" right="8" bottom="8" left="8"/>
                    </padding>

                    <!-- Forum Management Card -->
                    <VBox spacing="18" styleClass="modal-container">
                        <padding>
                            <Insets top="24" right="24" bottom="24" left="24"/>
                        </padding>
                        <Label text="⚙ GESTION DU FORUM" styleClass="modal-title"/>

                        <HBox spacing="20">
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="TITRE" styleClass="field-label"/>
                                <TextField fx:id="titleField" promptText="Titre du forum" styleClass="modal-input"/>
                            </VBox>
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="CRÉÉ PAR" styleClass="field-label"/>
                                <TextField fx:id="createdByField" promptText="Nom du créateur" styleClass="modal-input"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="20" alignment="CENTER_LEFT">
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="CATÉGORIE" styleClass="field-label"/>
                                <ComboBox fx:id="categoryField" styleClass="modal-combo"/>
                            </VBox>
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="STATUT DU SUJET" styleClass="field-label"/>
                                <ComboBox fx:id="topicStatusField" styleClass="modal-combo"/>
                            </VBox>
                            <VBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="ÉPINGLÉ" styleClass="field-label"/>
                                <CheckBox fx:id="pinnedField" text="Épingler le sujet" styleClass="field-label"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="10">
                            <Label text="DESCRIPTION" styleClass="field-label"/>
                            <TextArea fx:id="descriptionArea" promptText="Description du forum..." prefHeight="100"
                                      wrapText="true" styleClass="modal-input"/>
                        </VBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="✓ CRÉER" onAction="#handleAddForum" styleClass="submit-button"/>
                            <Button text="↻ METTRE À JOUR" onAction="#handleUpdateForum" styleClass="action-button, secondary-button"/>
                            <Button text="✕ SUPPRIMER" onAction="#handleDeleteForum" styleClass="action-button, danger-button"/>
                            <Button text="📌 ÉPINGLER" onAction="#handleTogglePin" styleClass="action-button, secondary-button"/>
                            <Button text="✔ RÉSOLU" onAction="#handleMarkResolved" styleClass="action-button, secondary-button"/>
                            <Button text="⚠ SIGNALER" onAction="#handleReportForum" styleClass="action-button, warning-button"/>
                            <Button text="👁 MASQUER" onAction="#handleHideForum" styleClass="action-button, warning-button"/>
                            <Button text="↺ RESTAURER" onAction="#handleRestoreForum" styleClass="action-button, secondary-button"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="✖ EFFACER" onAction="#handleClearForm" styleClass="action-button, neutral-button"/>
                        </HBox>
                    </VBox>

                    <!-- Featured Forum Card -->
                    <VBox spacing="14" styleClass="featured-card">
                        <padding>
                            <Insets top="18" right="18" bottom="18" left="18"/>
                        </padding>
                        <Label text="🔥 FORUM À LA UNE" styleClass="field-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label fx:id="featuredTitleLabel" text="Aucun forum pour le moment" styleClass="featured-title"/>
                            <Label fx:id="featuredMoodLabel" text="🔥 ACTIF" styleClass="mood-badge mood-active"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="featuredTrendLabel" text="TENDANCE 0" styleClass="trend-chip"/>
                        </HBox>
                        <Label fx:id="featuredMetaLabel" text="Créé par -" styleClass="featured-meta"/>
                        <Label fx:id="featuredDescLabel" text="Créez votre premier forum pour le voir mis en avant ici." styleClass="featured-desc"/>
                    </VBox>

                    <!-- Forum Cards List -->
                    <VBox spacing="16" prefWidth="1000">
                        <Label text="📋 TOUS LES FORUMS" styleClass="field-label"/>
                        <FlowPane fx:id="forumCardsContainer" prefWrapLength="980" hgap="16" vgap="16" styleClass="cards-flow"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </VBox>
</AnchorPane>
