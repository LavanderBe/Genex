<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Genex.Controllers.Forum.ForumController"
            prefHeight="720.0" prefWidth="1280.0"
            styleClass="main-container"
            stylesheets="@Forum.css">

    <VBox spacing="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <HBox alignment="CENTER" prefHeight="80.0" styleClass="top-nav">
            <HBox alignment="CENTER" spacing="0">
                <Button text="▶ FORUM" styleClass="nav-link, active-link" onAction="#openForum"/>
                <Button text="▶ PUBLICATIONS" styleClass="nav-link" onAction="#openPosts"/>
            </HBox>
        </HBox>

        <VBox spacing="20.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="40" right="60" bottom="40" left="60"/>
            </padding>

            <!-- Header Section -->
            <VBox spacing="8">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="▶" styleClass="campaign-icon"/>
                    <Label text="TERMINAL // ESPACE COMMUNAUTÉ" styleClass="subtitle-label"/>
                </HBox>
                <Label text="Forum / Discussions" styleClass="breadcrumb-label"/>
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="MODULE FORUM" styleClass="title-label"/>
                        <Label text="Créez et gérez les discussions de la communauté. Gardez une communication claire et votre équipe alignée."
                               styleClass="header-desc"/>
                    </VBox>
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="weather-widget">
                        <padding>
                            <Insets top="6" right="10" bottom="6" left="10"/>
                        </padding>
                        <ImageView fx:id="weatherIconView" fitHeight="22" fitWidth="22" preserveRatio="true"/>
                        <Label fx:id="weatherLabel" text="🌡 Chargement météo..." styleClass="featured-meta, weather-text" maxWidth="220" textOverrun="ELLIPSIS"/>
                        <Button text="↻" onAction="#handleRefreshHeaderData" styleClass="action-button, weather-refresh-button"/>
                    </HBox>
                    <Button fx:id="newForumButton" text="+ NOUVEAU FORUM" styleClass="primary-button" onAction="#handleClearForm"/>
                </HBox>
            </VBox>

            <!-- Search and Filters -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <HBox alignment="CENTER_LEFT" styleClass="search-container" HBox.hgrow="ALWAYS">
                    <Label text="🔍" styleClass="search-icon"/>
                    <TextField fx:id="searchField" promptText="Rechercher des forums..." HBox.hgrow="ALWAYS" styleClass="search-input"/>
                </HBox>
                <ComboBox fx:id="categoryFilterField" styleClass="modal-combo" prefWidth="150" promptText="Catégorie"/>
                <ComboBox fx:id="statusFilterField" styleClass="modal-combo" prefWidth="140" promptText="Statut"/>
                <ComboBox fx:id="moderationFilterField" styleClass="modal-combo" prefWidth="150" promptText="Modération"/>
                <ComboBox fx:id="sortFilterField" styleClass="modal-combo" prefWidth="150" promptText="Tri"/>
                <ComboBox fx:id="densityFilterField" styleClass="modal-combo" prefWidth="150" promptText="Densité"/>
            </HBox>

            <HBox spacing="18" VBox.vgrow="ALWAYS" styleClass="desktop-content-shell">
                <ScrollPane fitToWidth="true" styleClass="custom-scroll" HBox.hgrow="ALWAYS">
                    <VBox spacing="20" styleClass="cards-container">
                        <padding>
                            <Insets top="4" right="8" bottom="8" left="8"/>
                        </padding>

                    <VBox spacing="10">
                        <Label text="📰 FEED NEWS GAMING" styleClass="field-label"/>
                        <ScrollPane fitToHeight="false" fitToWidth="false" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                                    minHeight="190.0" prefHeight="190.0" maxHeight="190.0"
                                    styleClass="custom-scroll, news-feed-scroll">
                            <HBox fx:id="newsFeedContainer" spacing="14" styleClass="news-feed-row">
                                <padding>
                                    <Insets top="6" right="6" bottom="6" left="6"/>
                                </padding>
                            </HBox>
                        </ScrollPane>
                    </VBox>

                    <!-- Forum Management Card -->
                    <VBox fx:id="forumManagementCard" spacing="18" styleClass="modal-container">
                        <padding>
                            <Insets top="24" right="24" bottom="24" left="24"/>
                        </padding>
                        <Label text="⚙ GESTION DU FORUM" styleClass="modal-title"/>

                        <HBox spacing="20">
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="TITRE" styleClass="field-label"/>
                                <TextField fx:id="titleField" promptText="Titre du forum" styleClass="modal-input"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="20" alignment="CENTER_LEFT">
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="CATÉGORIE" styleClass="field-label"/>
                                <ComboBox fx:id="categoryField" styleClass="modal-combo"/>
                            </VBox>
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="STATUT DU SUJET" styleClass="field-label"/>
                                <ComboBox fx:id="topicStatusField" styleClass="modal-combo"/>
                            </VBox>
                            <VBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="ÉPINGLÉ" styleClass="field-label"/>
                                <CheckBox fx:id="pinnedField" text="Épingler le sujet" styleClass="field-label"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="10">
                            <Label text="DESCRIPTION" styleClass="field-label"/>
                            <HBox spacing="12" alignment="TOP_LEFT">
                                <TextArea fx:id="descriptionArea" promptText="Description du forum..." prefHeight="100"
                                          wrapText="true" styleClass="modal-input" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="generateDescButton" text="✨ GÉNÉRER" onAction="#handleGenerateDescription" 
                                        styleClass="action-button, primary-button" minHeight="40" wrapText="true" prefWidth="120"/>
                            </HBox>
                        </VBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="addForumButton" text="✓ CRÉER" onAction="#handleAddForum" styleClass="submit-button"/>
                            <Button fx:id="updateForumButton" text="↻ METTRE À JOUR" onAction="#handleUpdateForum" styleClass="action-button, secondary-button"/>
                            <Button fx:id="deleteForumButton" text="✕ SUPPRIMER" onAction="#handleDeleteForum" styleClass="action-button, danger-button"/>
                            <Button fx:id="pinForumButton" text="📌 ÉPINGLER" onAction="#handleTogglePin" styleClass="action-button, secondary-button"/>
                            <Button fx:id="resolveForumButton" text="✔ RÉSOLU" onAction="#handleMarkResolved" styleClass="action-button, secondary-button"/>
                            <Button fx:id="reportForumButton" text="⚠ SIGNALER" onAction="#handleReportForum" styleClass="action-button, warning-button"/>
                            <Button fx:id="hideForumButton" text="👁 MASQUER" onAction="#handleHideForum" styleClass="action-button, warning-button"/>
                            <Button fx:id="restoreForumButton" text="↺ RESTAURER" onAction="#handleRestoreForum" styleClass="action-button, secondary-button"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="✖ EFFACER" onAction="#handleClearForm" styleClass="action-button, neutral-button"/>
                        </HBox>
                    </VBox>

                    <!-- Featured Forum Card -->
                    <VBox spacing="14" styleClass="featured-card">
                        <padding>
                            <Insets top="18" right="18" bottom="18" left="18"/>
                        </padding>
                        <Label text="🔥 FORUM À LA UNE" styleClass="field-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label fx:id="featuredTitleLabel" text="Aucun forum pour le moment" styleClass="featured-title"/>
                            <Label fx:id="featuredMoodLabel" text="🔥 ACTIF" styleClass="mood-badge mood-active"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="featuredTrendLabel" text="TENDANCE 0" styleClass="trend-chip"/>
                        </HBox>
                        <Label fx:id="featuredMetaLabel" text="Créé par -" styleClass="featured-meta"/>
                        <Label fx:id="featuredDescLabel" text="Créez votre premier forum pour le voir mis en avant ici." styleClass="featured-desc"/>
                    </VBox>

                    <!-- Forum Cards List -->
                        <VBox spacing="16" prefWidth="1000">
                            <Label text="📋 TOUS LES FORUMS" styleClass="field-label"/>
                            <FlowPane fx:id="forumCardsContainer" prefWrapLength="980" hgap="16" vgap="16" styleClass="cards-flow"/>
                            <VBox fx:id="forumEmptyStateBox" spacing="10" styleClass="empty-state-box" visible="false" managed="false">
                                <Label fx:id="forumEmptyStateLabel" text="Aucun forum trouvé." styleClass="empty-state-title"/>
                                <HBox spacing="10" alignment="CENTER">
                                    <Button text="Réinitialiser filtres" styleClass="action-button, secondary-button" onAction="#handleResetForumFilters"/>
                                    <Button fx:id="forumEmptyCreateButton" text="Créer un sujet" styleClass="action-button, primary-button" onAction="#handleClearForm"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <VBox spacing="12" styleClass="desktop-sidebar">
                    <Label text="PILOTAGE DES SUJETS" styleClass="field-label"/>
                    <VBox spacing="10" styleClass="sidebar-card">
                        <Label text="📊 Vue rapide" styleClass="sidebar-title"/>
                        <Label fx:id="forumTotalCountLabel" text="Forums: 0" styleClass="sidebar-meta"/>
                        <Label fx:id="forumShownCountLabel" text="Affichés: 0" styleClass="sidebar-meta"/>
                        <Label fx:id="forumAuthorsCountLabel" text="Auteurs uniques: 0" styleClass="sidebar-meta"/>
                    </VBox>
                    <VBox fx:id="forumActionsSidebarCard" spacing="10" styleClass="sidebar-card">
                        <Label text="⚡ Actions" styleClass="sidebar-title"/>
                        <Button text="Nouveau forum" styleClass="action-button, secondary-button" onAction="#handleClearForm"/>
                        <Button text="Sélectionner le premier" styleClass="action-button, secondary-button" onAction="#handleSelectFirstForum"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>
