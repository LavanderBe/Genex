<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Genex.Controllers.Forum.PostsController"
            prefHeight="720.0" prefWidth="1280.0"
            styleClass="main-container"
            stylesheets="@Forum.css">

    <VBox spacing="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <HBox alignment="CENTER" prefHeight="80.0" styleClass="top-nav">
            <HBox alignment="CENTER" spacing="0">
                <Button text="▶ FORUM" styleClass="nav-link" onAction="#openForum"/>
                <Button text="▶ PUBLICATIONS" styleClass="nav-link, active-link" onAction="#openPosts"/>
            </HBox>
        </HBox>

        <VBox spacing="20.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="40" right="60" bottom="40" left="60"/>
            </padding>

            <!-- Header Section -->
            <VBox spacing="8">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="▶" styleClass="campaign-icon"/>
                    <Label text="TERMINAL // ESPACE COMMUNAUTÉ" styleClass="subtitle-label"/>
                </HBox>
                <Label text="Forum / Publications" styleClass="breadcrumb-label"/>
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="MODULE PUBLICATIONS" styleClass="title-label"/>
                        <Label text="Créez et gérez les publications du forum avec le même workflow et le même style visuel."
                               styleClass="header-desc"/>
                    </VBox>
                    <Button fx:id="newPostButton" text="+ NOUVEAU POST" styleClass="primary-button" onAction="#handleClearForm"/>
                </HBox>
            </VBox>

            <!-- Search and Filters -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <HBox alignment="CENTER_LEFT" styleClass="search-container" HBox.hgrow="ALWAYS">
                    <Label text="🔍" styleClass="search-icon"/>
                    <TextField fx:id="searchField" promptText="Rechercher des posts..." HBox.hgrow="ALWAYS" styleClass="search-input"/>
                </HBox>
                <ComboBox fx:id="typeFilterField" styleClass="modal-combo" prefWidth="145" promptText="Type"/>
                <ComboBox fx:id="statusFilterField" styleClass="modal-combo" prefWidth="145" promptText="Statut"/>
                <ComboBox fx:id="moderationFilterField" styleClass="modal-combo" prefWidth="160" promptText="Modération"/>
                <ComboBox fx:id="sortFilterField" styleClass="modal-combo" prefWidth="150" promptText="Tri"/>
                <ComboBox fx:id="densityFilterField" styleClass="modal-combo" prefWidth="150" promptText="Densité"/>
            </HBox>

            <HBox spacing="18" VBox.vgrow="ALWAYS" styleClass="desktop-content-shell">
                <ScrollPane fitToWidth="true" styleClass="custom-scroll" HBox.hgrow="ALWAYS">
                    <VBox spacing="20" styleClass="cards-container">
                        <padding>
                            <Insets top="4" right="8" bottom="8" left="8"/>
                        </padding>

                    <VBox spacing="10">
                        <Label text="📰 FEED NEWS GAMING" styleClass="field-label"/>
                        <ScrollPane fitToHeight="false" fitToWidth="false" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                                    minHeight="190.0" prefHeight="190.0" maxHeight="190.0"
                                    styleClass="custom-scroll, news-feed-scroll">
                            <HBox fx:id="newsFeedContainer" spacing="14" styleClass="news-feed-row">
                                <padding>
                                    <Insets top="6" right="6" bottom="6" left="6"/>
                                </padding>
                            </HBox>
                        </ScrollPane>
                    </VBox>

                    <!-- Post Management Card -->
                    <VBox spacing="18" styleClass="modal-container">
                        <padding>
                            <Insets top="24" right="24" bottom="24" left="24"/>
                        </padding>
                        <Label text="✍ GESTION DES POSTS" styleClass="modal-title"/>

                        <VBox spacing="10">
                            <Label text="NOM DU FORUM" styleClass="field-label"/>
                            <ComboBox fx:id="forumNameField" promptText="Sélectionner un forum" styleClass="modal-combo"/>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="TITRE" styleClass="field-label"/>
                            <TextField fx:id="titleField" promptText="Titre du post" styleClass="modal-input"/>
                        </VBox>

                        <HBox spacing="20">
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="TYPE DE POST" styleClass="field-label"/>
                                <ComboBox fx:id="postTypeField" styleClass="modal-combo"/>
                            </VBox>
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="STATUT" styleClass="field-label"/>
                                <ComboBox fx:id="postStatusField" styleClass="modal-combo"/>
                            </VBox>
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="TAG" styleClass="field-label"/>
                                <TextField fx:id="tagField" promptText="ex : gameplay" styleClass="modal-input"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="10">
                            <Label text="CONTENU" styleClass="field-label"/>
                            <TextArea fx:id="bodyArea" promptText="Contenu du post..." prefHeight="110"
                                      wrapText="true" styleClass="modal-input"/>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="VIDÉO (OPTIONNELLE)" styleClass="field-label"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="videoPathField" promptText="Aucune vidéo sélectionnée" editable="false" HBox.hgrow="ALWAYS" styleClass="modal-input"/>
                                <Button fx:id="selectVideoButton" text="📁 IMPORTER" onAction="#handleSelectVideo" styleClass="action-button, secondary-button"/>
                                <Button fx:id="clearVideoButton" text="✕ EFFACER" onAction="#handleClearVideo" styleClass="action-button, neutral-button"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="IMAGE (OPTIONNELLE)" styleClass="field-label"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="imagePathField" promptText="Aucune image sélectionnée" editable="false" HBox.hgrow="ALWAYS" styleClass="modal-input"/>
                                <Button fx:id="selectImageButton" text="🖼 IMPORTER" onAction="#handleSelectImage" styleClass="action-button, secondary-button"/>
                                <Button fx:id="clearImageButton" text="✕ EFFACER" onAction="#handleClearImage" styleClass="action-button, neutral-button"/>
                            </HBox>
                        </VBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="addPostButton" text="✓ CRÉER" onAction="#handleAddPost" styleClass="submit-button"/>
                            <Button fx:id="updatePostButton" text="↻ METTRE À JOUR" onAction="#handleUpdatePost" styleClass="action-button, secondary-button"/>
                            <Button fx:id="deletePostButton" text="✕ SUPPRIMER" onAction="#handleDeletePost" styleClass="action-button, danger-button"/>
                            <Button fx:id="reportPostButton" text="⚠ SIGNALER" onAction="#handleReportPost" styleClass="action-button, warning-button"/>
                            <Button fx:id="hidePostButton" text="👁 MASQUER" onAction="#handleHidePost" styleClass="action-button, warning-button"/>
                            <Button fx:id="restorePostButton" text="↺ RESTAURER" onAction="#handleRestorePost" styleClass="action-button, secondary-button"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="✖ EFFACER" onAction="#handleClearForm" styleClass="action-button, neutral-button"/>
                        </HBox>
                    </VBox>

                    <!-- Featured Post Card -->
                    <VBox spacing="14" styleClass="featured-card">
                        <padding>
                            <Insets top="18" right="18" bottom="18" left="18"/>
                        </padding>
                        <Label text="⭐ POST À LA UNE" styleClass="field-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label fx:id="featuredTitleLabel" text="Aucun post pour le moment" styleClass="featured-title"/>
                            <Label fx:id="featuredMoodLabel" text="🔥 ACTIF" styleClass="mood-badge mood-active"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="featuredTrendLabel" text="TENDANCE 0" styleClass="trend-chip"/>
                        </HBox>
                        <Label fx:id="featuredMetaLabel" text="Forum - • Par -" styleClass="featured-meta"/>
                        <Label fx:id="featuredDescLabel" text="Créez votre premier post pour le voir mis en avant ici." styleClass="featured-desc"/>
                    </VBox>

                    <!-- Posts List -->
                        <VBox spacing="16" prefWidth="1320">
                            <Label text="📝 TOUS LES POSTS" styleClass="field-label"/>
                            <FlowPane fx:id="postCardsContainer" prefWrapLength="1280" hgap="18" vgap="18" styleClass="cards-flow"/>
                            <VBox fx:id="postsEmptyStateBox" spacing="10" styleClass="empty-state-box" visible="false" managed="false">
                                <Label fx:id="postsEmptyStateLabel" text="Aucun post trouvé." styleClass="empty-state-title"/>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <VBox spacing="12" styleClass="desktop-sidebar">
                    <Label text="PILOTAGE DES POSTS" styleClass="field-label"/>
                    <VBox spacing="10" styleClass="sidebar-card">
                        <Label text="📊 Vue rapide" styleClass="sidebar-title"/>
                        <Label fx:id="postsTotalCountLabel" text="Posts: 0" styleClass="sidebar-meta"/>
                        <Label fx:id="postsShownCountLabel" text="Affichés: 0" styleClass="sidebar-meta"/>
                        <Label fx:id="postsResolvedCountLabel" text="Résolus: 0" styleClass="sidebar-meta"/>
                    </VBox>
                    <VBox spacing="10" styleClass="sidebar-card">
                        <Label text="⚡ Navigation rapide" styleClass="sidebar-title"/>
                        <Button text="Retour forum" styleClass="action-button, secondary-button" onAction="#openForum"/>
                        <Button text="Premier non lu" styleClass="action-button, secondary-button" onAction="#handleSelectFirstUnread"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>
